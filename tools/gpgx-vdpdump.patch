+/* tools/build-vectorman.sh: every write to the sound chips, one line
+ * each -- frame, cycle, Y or P, port, value -- into GPGX_SNDLOG. Its sound
+ * effects are recorded from this. */
+#undef FILE
+#undef fopen
+#undef fprintf
+#include <stdio.h>
+#include <stdlib.h>
+unsigned int gpgx_frame_no;
+void snd_log(char chip, unsigned int cycles, unsigned int a, unsigned int v)
+{
+  static FILE *f;
+  static int tried;
+  if (!tried) {
+    const char *p = getenv("GPGX_SNDLOG");
+    tried = 1;
+    if (p) f = fopen(p, "w");
+  }
+  if (f) fprintf(f, "%u %u %c %u %u\n", gpgx_frame_no, cycles, chip, a, v);
+}
+
