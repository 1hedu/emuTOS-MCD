+                beq.s   @T0448091
+                addq.l  #4,A1
+                bra.s   @T0448090
+        @T0448091:
+                movea.l (A1),A1                                         /* struct scd_api */
+                movea.l 8(A1),A1                                        /* control(op, a, b, c) */
+                lea     V0448000_BulkInfo(PC),A0
+                clr.l   -(A7)
+                clr.l   -(A7)
