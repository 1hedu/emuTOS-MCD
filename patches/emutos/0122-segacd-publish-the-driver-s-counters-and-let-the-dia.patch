+/******************************************************************************/
+/* What a program can ask the driver                                          */
+/******************************************************************************/
+
+/* The disc diagnostic used to live in biosmain: 222 lines of it, run
+ * by holding a direction at power-on. It is a program on the A:
+ * ramdisk now, which is better in every direction -- it is launched
+ * when it is wanted rather than gambled on at power-on, it cannot take
+ * the boot down with it, and the EmuTOS image gets 222 lines shorter
+ * at a moment when it had four bytes of headroom.
+ *
+ * The only thing that was stopping it being a program is that the
+ * numbers it reports are this driver's private counters. So they are
+ * published: one call that fills a struct, one that pulls the levers,
+ * and a pointer to the pair in the cookie jar under 'SgCD', which is
+ * how a TOS program has always found a driver.
+ *
+ * One snapshot call rather than twenty accessors, so that every number
+ * in a printed round describes the same moment. */
+static void scd_snapshot(struct scd_snap *s)
+{
+    UWORD seeks, hits, errs, why, bad, wrong, torn, flag, fix;
+    UWORD flba, fsame, ts, tsf, tsrc, lints, badmode, h3same;
+    WORD wdelta, lshort;
+    UBYTE state, lasth3, h3first;
+    UWORD ringok, dsr, edt, nz, boff, bnz, slotbad, v[4];
+    ULONG newest, blba, swant, sgot, sbase;
+    UBYTE shave, ssrc, bsrc, hdr[4], st4[4];
+    int i;
+
+    memset(s, 0, sizeof(*s));
+    s->size = sizeof(*s);
+    s->version = SCD_VERSION;
+
+    segacd_cd_stats(&seeks, &hits, &errs, &state, &why, &bad, &wrong,
+                    &torn, &flag, &wdelta, &fix, &flba, &fsame, &ts, &tsf,
+                    &tsrc, &lints, &lshort, &badmode, &lasth3,
+                    &h3first, &h3same);
+    s->seeks = seeks; s->hits = hits; s->errs = errs; s->state = state;
+    s->why = why; s->bad = bad; s->wrong = wrong; s->torn = torn;
+    s->flag = flag; s->wdelta = wdelta; s->fix = fix; s->flba = flba;
+    s->fsame = fsame; s->ts = ts; s->tsf = tsf; s->tsrc = tsrc;
+    s->lints = lints; s->lshort = lshort; s->badmode = badmode;
+    s->lasth3 = lasth3; s->h3first = h3first; s->h3same = h3same;
+
+    segacd_cd_probe(&ringok, &newest, &dsr, &edt, &nz, hdr, st4,
+                    &blba, &boff, &bsrc, &bnz, &slotbad, &swant, &sgot,
+                    &sbase, &shave, &ssrc, v);
+    s->ringok = ringok; s->newest = newest; s->dsr = dsr; s->edt = edt;
+    s->nz = nz; s->blba = blba; s->boff = boff; s->bsrc = bsrc;
+    s->bnz = bnz; s->slotbad = slotbad; s->swant = swant; s->sgot = sgot;
+    s->sbase = sbase; s->shave = shave; s->ssrc = ssrc;
+    for (i = 0; i < 4; i++) {
+        s->hdr[i] = hdr[i]; s->st4[i] = st4[i]; s->v[i] = v[i];
+    }
+
+    {
+        ULONG i4, own, vec4, st, cm;
+        UWORD ctrl, lost, ctl2;
+
+        segacd_bios_ipath(&i4, &own, &vec4, &ctrl, &lost);
+        segacd_bios_cdd(&st, &cm, &ctl2);
+        s->i4 = i4; s->own = own; s->vec4 = vec4;
+        s->ctrl = ctrl; s->lost = lost;
+        s->st = st; s->cm = cm; s->ctl2 = ctl2;
+    }
+
+    s->bram = segacd_bram_state();
+    s->bootflags = segacd_bootflags;
+}
+
+static ULONG scd_control(LONG op, LONG a, LONG b, LONG c)
+{
+    switch (op) {
+    case SCD_TUNE:      segacd_cd_tune((UWORD)a, (UWORD)b, (UWORD)c); break;
+    case SCD_TS_TUNE:   segacd_ts_tune((WORD)a); break;
+    case SCD_TS_ARM:    segacd_ts_arm((WORD)a); break;
+    case SCD_TS_REARM:  segacd_ts_rearm(); break;
+    case SCD_REVIVE:    segacd_cd_revive(); break;
+    case SCD_BIOS_PROBE:    return segacd_bios_probe();
+    case SCD_BIOS_READTEST: return segacd_bios_readtest();
+    case SCD_BIOS_NEARREAD: return segacd_bios_nearread();
+    case SCD_BIOS_SWAPS:    return segacd_bios_swaps();
+    }
+    return 0;
+}
+
+static const struct scd_api scd_api = {
+    sizeof(struct scd_api), SCD_VERSION, scd_snapshot, scd_control
+};
+
+void segacd_publish_api(void)
+{
+    cookie_add(SCD_COOKIE, (ULONG)&scd_api);
+}
