 bios/bios.c   | 345 ++++----------------------------------------------
 bios/scdapi.h | 104 +++++++++++++++
 bios/segacd.c |  98 ++++++++++++++
 bios/segacd.h |   1 +
 4 files changed, 226 insertions(+), 322 deletions(-)
 create mode 100644 bios/scdapi.h

