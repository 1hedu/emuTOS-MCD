diff --git a/bios/scdapi.h b/bios/scdapi.h
new file mode 100644
index 0000000..a45fa53
--- /dev/null
+++ b/bios/scdapi.h
@@ -0,0 +1,104 @@
+/*
+ * scdapi.h - what the Sega CD driver tells a program about itself
+ *
+ * Compiled by two things that do not share a build: the driver, in
+ * bios/segacd.c, and ordinary TOS programs on the A: ramdisk. So it
+ * uses plain short/long rather than EmuTOS's own types, which are not
+ * the same width on both sides -- EmuTOS builds -mshort and a .PRG
+ * does not, so `int` means two different things and neither side may
+ * use it.
+ *
+ * The driver publishes a pointer to a struct scd_api in the cookie
+ * jar under 'SgCD'. That is how TOS has always let a program find a
+ * driver, and it is why the disc diagnostic can be a program the
+ * desktop launches rather than 222 lines wired into biosmain: the
+ * counters it needs are the driver's, and this is the only thing that
+ * was stopping them being reachable from outside.
+ *
+ * Both structs carry their own size and a version. A program that
+ * finds a size it was not compiled against must refuse to read the
+ * fields, because the alternative is a confident readout of the wrong
+ * offsets -- which this project has already done to itself once.
+ *
+ * This file is distributed under the GPL, version 2 or at your
+ * option any later version.  See doc/license.txt for details.
+ */
+
+#ifndef SCDAPI_H
+#define SCDAPI_H
+
+#define SCD_COOKIE   0x53674344L        /* 'SgCD' */
+#define SCD_VERSION  2
+
+/* Everything the disc diagnostic prints, in one go. Taken in a single
+ * call rather than twenty accessors so that the numbers in one report
+ * describe one moment. */
+struct scd_snap {
+    unsigned short size;                /* sizeof(struct scd_snap) */
+    unsigned short version;
+
+    /* the block layer's account of itself */
+    unsigned short seeks, hits, errs;
+    unsigned char  state;               /* the drive's own status nibble */
+    unsigned short why;                 /* one nibble per attempt */
+    unsigned short bad, wrong, torn, flag;
+    short          wdelta;
+    unsigned short fix, flba, fsame;
+    unsigned short ts, tsf, tsrc;       /* the timeshare */
+    unsigned short lints;
+    short          lshort;
+    unsigned short badmode;             /* rejected by the mode gate */
+    unsigned char  lasth3, h3first;     /* ...the last and first byte */
+    unsigned short h3same;              /* ...and how many matched the first */
+
+    /* the ring, the transfer, and the last block handed to GEMDOS */
+    unsigned short ringok;
+    unsigned long  newest;
+    unsigned short dsr, edt, nz;
+    unsigned char  hdr[4], st4[4];
+    unsigned long  blba;
+    unsigned short boff;
+    unsigned char  bsrc;
+    unsigned short bnz;
+    unsigned short slotbad;
+    unsigned long  swant, sgot, sbase;
+    unsigned char  shave, ssrc;
+    unsigned short v[4];                /* STAT0 bit 7 against the mode gate */
+
+    /* the parked firmware, if there is any */
+    unsigned long  i4, own, vec4;
+    unsigned short ctrl, lost;
+    unsigned long  st, cm;
+    unsigned short ctl2;
+
+    unsigned char  bram;                /* 0 none 1 ours 2 Sega saves */
+    unsigned short bootflags;           /* the raw button word */
+};
+
+/* Ops for scd_api.control(). Arguments that are not used are ignored;
+ * the return value is meaningful only where noted. */
+#define SCD_TUNE      0                 /* a=lead b=hold c=late */
+#define SCD_TS_TUNE   1                 /* a=wake the firmware with DRV_INIT */
+#define SCD_TS_ARM    2                 /* a=hand the disc to the firmware */
+#define SCD_TS_REARM  3
+#define SCD_BIOS_PROBE    4             /* -> CDBCHK, or 0xFFFF for none */
+#define SCD_BIOS_READTEST 5             /* -> 0 if the firmware read a sector */
+#define SCD_BIOS_NEARREAD 6             /* -> ...one it read at boot */
+#define SCD_BIOS_SWAPS    7             /* -> how many exchanges have run */
+#define SCD_REVIVE        8             /* the drive gets another chance */
+
+struct scd_api {
+    unsigned short size;                /* sizeof(struct scd_api) */
+    unsigned short version;
+    void (*snapshot)(struct scd_snap *s);
+    /* long, not short, and that is not fussiness. EmuTOS is built
+     * -mshort and a .PRG is not, so a `short` argument is pushed as two
+     * bytes by one and promoted to four by the other: every call came
+     * through with op read from the wrong half of the first argument,
+     * which made every op look like op 0. It even passed the size and
+     * version check, because the struct is the same size either way.
+     * long is four bytes to both. */
+    unsigned long (*control)(long op, long a, long b, long c);
+};
+
+#endif /* SCDAPI_H */
diff --git a/bios/segacd.c b/bios/segacd.c
