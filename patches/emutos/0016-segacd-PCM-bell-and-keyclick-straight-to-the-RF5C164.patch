+#if defined(MACHINE_SEGACD) && defined(CONF_SEGACD_PCMTEST)
+    /*
+     * Diagnostic build only: prove the PCM chip is actually running.
+     * A channel's play address register advances while it sounds, so
+     * two reads a moment apart say whether anything is happening --
+     * the only way to check audio on a headless emulator.
+     */
+    {
+        volatile UBYTE *addr_l = (volatile UBYTE *)0xFF0021;
+        volatile UBYTE *addr_h = (volatile UBYTE *)0xFF0023;
+        UWORD a0, a1, a2;
+        LONG spin;
+
+        cprintf("\033EPCM test\r\n");
+
+        {   /* does the wave RAM window and its bank select work at all? */
+            volatile UBYTE *w = (volatile UBYTE *)0xFF2001;
+            int j, bad = 0;
+            *(volatile UBYTE *)0xFF000F = 0xC0;      /* enable, bank 0 */
+            for (j = 0; j < 64; j++)
+                w[j * 2] = (UBYTE)(j ^ 0x5A);
+            for (j = 0; j < 64; j++)
+                if (w[j * 2] != (UBYTE)(j ^ 0x5A))
+                    bad++;
+            cprintf("wave RAM  = %d bad of 64\r\n", bad);
+        }
+
+        a0 = (UWORD)((*addr_h << 8) | *addr_l);
+        segacd_sound_init();
+        segacd_bell();
+        for (spin = 0; spin < 200000L; spin++)
+            __asm__ volatile("");       /* an empty loop gets optimised away */
+        a1 = (UWORD)((*addr_h << 8) | *addr_l);
+        for (spin = 0; spin < 200000L; spin++)
+            __asm__ volatile("");
+        a2 = (UWORD)((*addr_h << 8) | *addr_l);
+        cprintf("chan addr = %04x %04x %04x\r\n", a0, a1, a2);
+        cprintf("advancing = %s\r\n", (a1 != a2) ? "YES" : "no");
