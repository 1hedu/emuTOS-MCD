+/******************************************************************************/
+/* Sound: RF5C164 PCM                                                         */
+/******************************************************************************/
+
+/* The Mega CD's PCM chip sits on the sub CPU's own bus, odd bytes only,
+ * exactly like the internal backup RAM. No BIOS call is involved, which
+ * matters here because the CDBIOS is evicted at handoff.
+ *
+ * Registers select either a channel (bit 7 clear, channel in bits 2-0)
+ * or a wave RAM bank (bit 7 set, bank in bits 3-0); bit 6 is the chip's
+ * master enable and has to stay set once we want sound at all. */
+#define PCM_ENV     (*(volatile UBYTE *)0xFF0001)
+#define PCM_PAN     (*(volatile UBYTE *)0xFF0003)
+#define PCM_FDL     (*(volatile UBYTE *)0xFF0005)
+#define PCM_FDH     (*(volatile UBYTE *)0xFF0007)
+#define PCM_LSL     (*(volatile UBYTE *)0xFF0009)
+#define PCM_LSH     (*(volatile UBYTE *)0xFF000B)
+#define PCM_ST      (*(volatile UBYTE *)0xFF000D)
+#define PCM_CTRL    (*(volatile UBYTE *)0xFF000F)
+#define PCM_ONOFF   (*(volatile UBYTE *)0xFF0011)
+#define PCM_WAVE    0xFF2001UL          /* 4K window, odd bytes */
+
+#define PCM_CYCLE   32                  /* samples in one cycle of the tone */
+#define PCM_LEN     2048                /* one-shot length: ~63 ms */
+#define PCM_BELL_FRAMES  8              /* backstop, well past the sample */
+#define PCM_CLICK_FRAMES 2
+
+static UBYTE pcm_countdown;             /* VBLs left before we silence it */
+
+/* A decaying triangle tone, sign-magnitude: bit 7 is the sign, bits 6-0
+ * the magnitude. 0xFF is the chip's end-of-sample marker, so magnitudes
+ * must stay below it.
+ *
+ * The sample is a self-terminating one-shot rather than a loop the VBL
+ * has to switch off: the terminator at the end jumps to a loop address
+ * that holds another terminator, so the channel falls silent on its own
+ * and cannot drone if interrupts are ever not flowing. The countdown in
+ * the VBL is only a backstop. */
+static void pcm_load_wave(void)
+{
+    UWORD i;
+
+    PCM_CTRL = 0xC0;                    /* enable, wave RAM bank 0 */
+    for (i = 0; i < PCM_LEN; i++) {
+        UWORD ph = (UWORD)(i % PCM_CYCLE);
+        WORD q = (ph < PCM_CYCLE / 2) ? ph : (PCM_CYCLE - 1 - ph);
+        /* linear decay across the whole sample */
+        UWORD peak = (UWORD)(0x70u * (ULONG)(PCM_LEN - i) / PCM_LEN);
+        UBYTE mag = (UBYTE)((UWORD)q * peak / (PCM_CYCLE / 2));
+        UBYTE v = (ph < PCM_CYCLE / 2) ? (UBYTE)(0x80 | mag) : mag;
+        *(volatile UBYTE *)(PCM_WAVE + (ULONG)i * 2) = v;
+    }
+    *(volatile UBYTE *)(PCM_WAVE + (ULONG)PCM_LEN * 2) = 0xFF;
+}
+
+void segacd_sound_init(void)
+{
+    pcm_load_wave();
+
+    PCM_CTRL = 0x40;                    /* enable, program channel 0 */
+    PCM_ENV = 0xC0;                     /* volume */
+    PCM_PAN = 0xFF;                     /* both speakers */
+    PCM_FDL = 0x00;                     /* step 1 sample per tick: the chip */
+    PCM_FDH = 0x08;                     /* runs at 32552 Hz, so ~1017 Hz */
+    PCM_LSL = (UBYTE)(PCM_LEN & 0xFF);  /* loop onto the terminator, so */
+    PCM_LSH = (UBYTE)(PCM_LEN >> 8);    /* the tone ends by itself */
+    PCM_ST  = 0x00;                     /* sample begins at wave RAM 0 */
+    PCM_ONOFF = 0xFF;                   /* every channel off for now */
+    pcm_countdown = 0;
+}
+
+static void pcm_beep(UBYTE frames, UBYTE volume)
+{
+    PCM_CTRL = 0x40;                    /* channel 0 registers */
+    PCM_ENV = volume;
+    PCM_ONOFF = 0xFE;                   /* channel 0 on, the rest off */
+    pcm_countdown = frames;
+}
+
+void segacd_bell(void)
+{
+    pcm_beep(PCM_BELL_FRAMES, 0xC0);
+}
+
+void segacd_keyclick(void)
+{
+    pcm_beep(PCM_CLICK_FRAMES, 0x50);
+}
+
 /******************************************************************************/
 /* System timer                                                               */
 /******************************************************************************/
@@ -130,6 +219,11 @@ void segacd_int_2_c(void)
         }
     }
 
+    if (pcm_countdown) {                /* silence the bell when it is due */
+        if (--pcm_countdown == 0)
+            PCM_ONOFF = 0xFF;
+    }
+
