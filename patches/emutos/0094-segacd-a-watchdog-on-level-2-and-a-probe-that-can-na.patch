-_segacd_bios_int4:
+// What the last visit saw. All of it lives outside the exchanged region,
+// so the handlers below can reach it with Sega's world in low memory.
+_segacd_bios_int4:                      // level 4s, whole visit
+        .long   0
+_segacd_bios_own:                       // ...of which, before the
+        .long   0                       //    firmware's handler went in
