         .long   0
+_segacd_bios_ctrl:                      // $FF8037 and $FF8033 on entry
+        .word   0
         .text
 
-// Level 4, during a visit: count it, then hand it straight to the
-// firmware's own handler.
+// Level 2, during a visit: the dead-man switch.
+//
+// Everything the firmware is asked to do is untimed from our side. A
+// BIOS call is a jsr; if it does not come back there is no loop to
+// bound, no counter to expire, and no way to print why -- the console
+// simply stops, which is what it did, twice, on a screen with nothing
+// on it but the version banner.
+//
+// So the visit is bounded from outside by the one clock the CD cannot
+// stop: the Genesis raises MDINT every frame whatever the drive is
+// doing. Five seconds of frames and the visit is abandoned where it
+// stands -- stack reset, stage 5, straight to the exit path, which
+// swaps EmuTOS back in and returns a code like any other failure.
 //
-// This exists because the read pipeline is not self-contained. ROMREADN
-// arms the CDC and returns; every byte after that moves inside the
-// BIOS's CDD (level 4) and decoder (level 5) handlers. DRVINIT is worse
-// -- it waits for a TOC that only its own level 4 can deliver, and it
-// has no timeout, so an unserviced CDD is not a slow read, it is a
-// frozen console. That is what the machine did.
+// The interrupt frame is discarded rather than returned through. That
+// is the point: there is nothing to return to.
+bios_int2_watch:
+        addq.l  #1,_segacd_bios_frames
+        cmpi.l  #300,_segacd_bios_frames
+        bcs     1f
+        lea     0x7C000,a5              // abandoning: registers are ours
+        move.w  #5,32(a5)
+        move.l  #0x7C900,sp
+        jmp     brd_done
+1:      rte
+
+// Level 4, phase A: our own acknowledge, and nobody else's.
+//
+// The hardware answer to the first build that got this far was i4 1 --
+// one level 4 for the whole visit, then silence, every visit. Either
+// the interrupt never really flows with Sega's vectors in place, or it
+// flows until Sega's handler runs once and then stops. Those are very
+// different problems and the counter as it stood could not tell them
+// apart.
+//
+// This handler is the discriminator. It is the sequence EmuTOS's own
+// level 4 uses -- wait out DRS, take the ten status bytes, write $04
+// back to acknowledge -- which is known to keep this machine's drive
+// talking at 75 Hz for minutes at a time, because that is what the CD
+// driver has been doing all along. If level 4 flows under this and dies
+// under Sega's, the firmware's handler is what kills it.
+bios_int4_own:
+        movem.l d0/a0-a1,-(sp)
+        move.w  #200,d0
+2:      btst    #1,0xFF8037             // DRS: a packet is on its way in
+        dbeq    d0,2b
+        lea     0xFF8038,a0
+        lea     0x7C060,a1
+        move.l  (a0)+,(a1)+
+        move.l  (a0)+,(a1)+
+        move.w  (a0)+,(a1)+
+        move.b  #0x04,0xFF8037          // HOCK stays, DTS and DRS clear
+        addq.l  #1,_segacd_bios_int4
+        movem.l (sp)+,d0/a0-a1
+        rte
+
+// Level 4, phase B: count it, then hand it to the firmware's own
+// handler, which is the one that has to run for a read to progress.
 //
-// So the visit proves level 4 is arriving before it calls anything that
-// waits on it. Counting means interposing, and interposing means not
-// disturbing: no register is touched, and the chain is a push of the
-// firmware's own vector followed by rts, because loading it into an
-// address register inside an interrupt would clobber the interrupted
-// code's a0.
+// Interposing means not disturbing: no register is touched, and the
+// chain is a push of the firmware's own vector followed by rts, because
+// loading it into an address register inside an interrupt would clobber
+// the interrupted code's a0.
 bios_int4_stub:
         addq.l  #1,_segacd_bios_int4
         move.l  _segacd_bios_vec4,-(sp)
@@ -282,7 +347,8 @@ bios_int4_stub:
 //   a5+4   sectors left      a5+32  stage code
 //   a5+8   destination       a5+34  drive state as last seen
 //   a5+12  header scratch    a5+36  EmuTOS's gate-array mask
-//   a5+40  DRV_INIT parameters
+//   a5+40  DRV_INIT params   a5+44  EmuTOS's stack pointer
+//   a5+96  status packet the phase-A handler took
         .globl  _segacd_bios_read
 _segacd_bios_read:
         move.l  4(sp),d0                // lba
@@ -295,6 +361,11 @@ _segacd_bios_read:
         move.l  #0x7C900,sp             // scratch stack, outside the swap
