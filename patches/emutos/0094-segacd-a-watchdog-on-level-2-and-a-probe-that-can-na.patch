+        // The answer is the carry flag, not d0. CDBCHK's "is the drive
+        // busy" came back 007F on hardware and 0000 in emulation, and
+        // neither number meant anything: d0 is scratch after a call, and
+        // every documented CDBIOS status is cc/cs. Return bit 8 as the
+        // carry and keep d0's low byte for whatever it turns out to be.
+        moveq   #0,d1
+        scs     d1
+        andi.w  #0x00FF,d0
+        andi.w  #0x0001,d1
+        lsl.w   #8,d1
