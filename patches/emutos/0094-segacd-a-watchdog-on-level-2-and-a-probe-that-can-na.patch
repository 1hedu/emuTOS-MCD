diff --git a/bios/segacd2.S b/bios/segacd2.S
index bec4681..74e6639 100644
--- a/bios/segacd2.S
+++ b/bios/segacd2.S
@@ -180,6 +180,17 @@ _segacd_bios_call:
         bsr     bios_xchg
