From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: emuTOS-MCD <darekadumon@gmail.com>
Date: Tue, 11 Aug 2026 02:26:48 +0000
Subject: [PATCH 024/190] segacd: talk to the CD drive with no BIOS (E6 stage
 1)

The CDD exchanges fixed 10-nibble packets through the gate array: ten
status nibbles at $FF8038, ten command nibbles at $FF8042, each in the
low four bits of its own byte, the tenth of each a checksum over the
other nine. Setting HOCK makes the drive publish its status every
1/75 s unprompted, so a well-formed packet proves the link before any
command is sent -- one control bit for the answer to "does the drive
still talk to us now the BIOS is evicted".

It does: CDD Y 100 on Genesis Plus GX, CDD Y 110 on PicoDrive, checksum
verified in both. Reported on the status line in place of the FS and BP
fields, which have served their purpose.

Register semantics taken from Genesis Plus GX's cdd.c rather than
inferred from a working SDK's usage, which is the lesson from the PCM
driver.
---
 bios/bios.c   | 26 ++++++++++++++++++++++++++
 bios/segacd.c | 48 ++++++++++++++++++++++++++++++++++++++++++++++++
 bios/segacd.h |  3 +++
 3 files changed, 77 insertions(+)

diff --git a/bios/bios.c b/bios/bios.c
index bd02171..b2757a0 100644
--- a/bios/bios.c
+++ b/bios/bios.c
@@ -874,6 +874,32 @@ void biosmain(void)
     }
 #endif
 
+#if defined(MACHINE_SEGACD) && defined(CONF_SEGACD_FMTTEST)
+    /*
+     * Diagnostic build only: run the shipped FORMAT.PRG headlessly.
+     * Its prompts are answered by injecting scancodes the same way the
+     * on-screen keyboard does, so this exercises the exact binary that
+     * goes on the disc rather than a variant built for testing.
+     */
+    {
+        static char buf[64];
+        LONG rc;
+
+        call_ikbdraw(0x15);             /* 'Y' press */
+        call_ikbdraw(0x95);             /* and release */
+        call_ikbdraw(0x39);             /* space, for "press any key" */
+        call_ikbdraw(0xB9);
+
+        rc = Pexec(PE_LOADGO, "A:\\FORMAT.PRG", "", NULL);
+        cprintf("\r\nPexec    = %ld\r\n", rc);
+        rc = Dfree(buf, 2);
+        cprintf("B: free  = %ld of %ld\r\n",
+                *(LONG *)buf, *((LONG *)buf + 1));
+        for (;;)
+            ;
+    }
+#endif
+
 #if defined(MACHINE_SEGACD) && defined(CONF_SEGACD_PCMTEST)
     /*
      * Diagnostic build only: prove the PCM chip is actually running.
diff --git a/bios/segacd.c b/bios/segacd.c
index a0c4e01..85ed85b 100644
--- a/bios/segacd.c
+++ b/bios/segacd.c
@@ -73,6 +73,46 @@ const UBYTE *segacd_physbase(void)
     return logbase();
 }
 
+/******************************************************************************/
+/* CD drive (CDD), BIOS-free                                                  */
+/******************************************************************************/
+
+/* The CDBIOS is evicted, so the drive has to be talked to directly. The
+ * CDD exchanges fixed 10-nibble packets with the host through the gate
+ * array: ten status nibbles at $FF8038, ten command nibbles at $FF8042,
+ * each nibble in the low four bits of its own byte. The tenth nibble of
+ * each packet is a checksum, the low nibble of ~(sum of the other
+ * nine).
+ *
+ * Setting HOCK makes the drive publish its status every 1/75 s whether
+ * or not anything was asked of it, so simply reading a well-formed
+ * packet proves the link works before any command is ever sent. That is
+ * the first thing worth knowing and it costs one control bit. */
+#define CDD_CTRL    ((volatile UBYTE *)0xFF8037)
+#define CDD_STATUS  ((const volatile UBYTE *)0xFF8038)
+#define CDD_HOCK    0x04
+
+static UBYTE cdd_stat[10];
+static UBYTE cdd_valid;
+
+void segacd_cdd_init(void)
+{
+    *CDD_CTRL |= CDD_HOCK;      /* start the 75 Hz status reports */
+}
+
+/* Latch one status packet and check it. Cheap enough for the VBL. */
+static void cdd_poll(void)
+{
+    UBYTE sum = 0;
+    int i;
+
+    for (i = 0; i < 10; i++)
+        cdd_stat[i] = (UBYTE)(CDD_STATUS[i] & 0x0F);
+    for (i = 0; i < 9; i++)
+        sum = (UBYTE)(sum + cdd_stat[i]);
+    cdd_valid = (UBYTE)((((~sum) & 0x0F) == cdd_stat[9]) ? 1 : 0);
+}
+
 /******************************************************************************/
 /* Sound: RF5C164 PCM                                                         */
 /******************************************************************************/
@@ -262,6 +302,12 @@ void segacd_int_2_c(void)
         }
     }
 
+    cdd_poll();
+    *(volatile UWORD *)0xFF8022 = (UWORD)((cdd_valid ? 0x8000 : 0)
+        | ((UWORD)cdd_stat[0] << 8)
+        | ((UWORD)cdd_stat[1] << 4)
+        |  (UWORD)cdd_stat[2]);
+
     /* Sound telemetry, packed into the spare bits of the drive status
      * word: no comm register is free, and this answers the only
      * question a silent console cannot -- whether the keyclick chain
@@ -458,6 +504,8 @@ static UWORD bram_fs_signature(void)
 
 void segacd_floppy_init(void)
 {
+    segacd_cdd_init();
+
     /* the builder stamps "EmuTOSMD" as the OEM field at offset 2 */
     adisk_present = (ADISK_BASE[2] == 'E' && ADISK_BASE[3] == 'm'
                   && ADISK_BASE[4] == 'u' && ADISK_BASE[5] == 'T');
diff --git a/bios/segacd.h b/bios/segacd.h
index 7232840..f3a8d52 100644
--- a/bios/segacd.h
+++ b/bios/segacd.h
@@ -23,6 +23,9 @@ void segacd_init_system_timer(void);
 /* Keyboard/mouse (events arrive from the main-CPU servant; stub for now) */
 void segacd_kbd_init(void);
 
+/* CD drive, no BIOS involved */
+void segacd_cdd_init(void);
+
 /* Sound: RF5C164 PCM, no BIOS involved */
 void segacd_sound_init(void);
 void segacd_bell(void);
