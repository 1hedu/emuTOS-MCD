         return EUNDEV;
     }
 
-    if (!cart_sectors) {            /* internal BRAM, sub-side, direct */
+    {                               /* internal BRAM, sub-side, direct */
         ULONG off;
-        if (bram_state != BRAM_OURS) {
+        if (bram_state == BRAM_NONE) {
             *(volatile UWORD *)0xFF802E = 0xEE01;
             return EUNDEV;
         }
@@ -3860,29 +3874,78 @@ WORD segacd_floprw(UBYTE *buf, WORD rw, WORD dev, WORD sect, WORD track,
         }
         return E_OK;
     }
+}
 
-    if (lba + count > cart_sectors)
+/******************************************************************************/
+/* C: -- the cartridge's save RAM                                             */
+/******************************************************************************/
+
+/* Its own drive rather than an alternative B:.
+ *
+ * The sub CPU has no path to the cartridge bus at all -- the cartridge
+ * is on the Genesis side of the machine -- so every sector goes through
+ * the servant: the LBA and an operation into comm registers, the data
+ * through a bounce buffer in Word RAM, and a sequence number echoed
+ * back so a stale answer cannot be mistaken for a fresh one. That
+ * proxy already existed for the old B:; only the drive letter and the
+ * entry point are new.
+ *
+ * It is a block device rather than a third floppy because EmuTOS has
+ * exactly two floppies, and because C: is where it belongs: probed
+ * ahead of the disc, so on a Mode 1 boot the storage that is certainly
+ * present gets the first letter and the disc gets D:.
+ */
+LONG segacd_cart_rw(WORD rw, LONG sector, WORD count, UBYTE *buf)
+{
+    WORD err;
+
+    if (!cart_sectors)
+        return EUNDEV;
+    if (sector < 0 || sector + count > cart_sectors)
         return ESECNF;
 
     while (count--) {
-        if (rw & 1) {
+        if (rw & RW_WRITE) {
             memcpy((void *)BOUNCE, buf, SECTOR_SIZE);
-            err = cart_xfer(2, (UWORD)lba);
-            *(volatile UWORD *)0xFF802C = (UWORD)lba;
+            err = cart_xfer(2, (UWORD)sector);
+            *(volatile UWORD *)0xFF802C = (UWORD)sector;
             *(volatile UWORD *)0xFF802E = (UWORD)err;
         } else {
-            err = cart_xfer(1, (UWORD)lba);
+            err = cart_xfer(1, (UWORD)sector);
             if (err == E_OK)
                 memcpy(buf, (const void *)BOUNCE, SECTOR_SIZE);
         }
         if (err != E_OK)
-            return (rw & 1) ? EWRITF : EREADF;
+            return (rw & RW_WRITE) ? EWRITF : EREADF;
         buf += SECTOR_SIZE;
-        lba++;
+        sector++;
     }
     return E_OK;
 }
 
+LONG segacd_cart_ioctl(WORD op, void *arg)
+{
+    ULONG *info = (ULONG *)arg;
+
+    if (!cart_sectors)
+        return EUNDEV;
+
+    switch (op) {
+    case GET_DISKINFO:
+        info[0] = cart_sectors;
+        info[1] = SECTOR_SIZE;
+        return E_OK;
+    case GET_DISKNAME:
+        strcpy((char *)arg, "Cartridge save RAM");
+        return E_OK;
+    case GET_MEDIACHANGE:
+        /* A cartridge cannot be changed with the power on, and the
+         * power going off ends EmuTOS along with the question. */
+        return MEDIANOCHANGE;
+    }
+    return ERR;
+}
+
