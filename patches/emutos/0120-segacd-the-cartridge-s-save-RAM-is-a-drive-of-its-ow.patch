 {
-    return cart_sectors ? 3 : bram_state;
+    return bram_state;
 }
 
 /* Read back the bytes GEMDOS's getbpb depends on, so the status line can
@@ -3725,12 +3729,17 @@ void segacd_floppy_init(void)
         segacd_event(5);
     cart_sectors = CART_CNT;    /* published by the servant at startup */
 
-    /* A backup RAM cart wins when present (bigger, and the console can
