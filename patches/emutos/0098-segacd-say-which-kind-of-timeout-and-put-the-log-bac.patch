-            cprintf(" Fsfirst  %ld   [%s]\r\n", rc, dta.d_fname);
+            DLOG(" Fsfirst  %ld   [%s]\r\n", rc, dta.d_fname);
 
             h = Fopen("C:\\READCD.TXT", 0);
-            cprintf(" Fopen    %ld\r\n", h);
+            DLOG(" Fopen    %ld\r\n", h);
             if (h >= 0L) {
                 rc = Fread((WORD)h, 32L, buf);
                 Fclose((WORD)h);
@@ -1115,18 +1188,27 @@ void biosmain(void)
                     if (buf[i] < 32 || buf[i] > 126)
                         buf[i] = '.';
                 buf[24] = 0;
-                cprintf(" Fread    %ld   [%s]\r\n", rc, buf);
+                DLOG(" Fread    %ld   [%s]\r\n", rc, buf);
             }
 
             segacd_cd_stats(&seeks, &hits, &errs, &state, &why,
                             &bad, &wrong, &torn, &flag, &wdelta, &fix,
-                            &flba, &fsame, &ts, &tsf, &tsrc);
-            cprintf(" drive %X  seek %u  wait %u  err %u  why %04X\r\n",
+                            &flba, &fsame, &ts, &tsf, &tsrc,
+                            &lints, &lshort);
+            DLOG(" drive %X  seek %u  wait %u  err %u  why %04X\r\n",
                     state, seeks, hits, errs, why);
-            cprintf(" torn %u bcd %u wr %u l%d fx %u fl %u\r\n",
+            DLOG(" torn %u bcd %u wr %u l%d fx %u fl %u\r\n",
                     torn, bad, wrong, wdelta, fix, flag);
-            cprintf(" lastfail %u x%u  CDBIOS rd %u fl %u %04X\r\n",
+            DLOG(" lastfail %u x%u  CDBIOS rd %u fl %u %04X\r\n",
                     flba, fsame, ts, tsf, tsrc);
+            /* What the timeout meant. int is how many sectors the
+             * decoder announced while the attempt waited; d is how far
+             * the newest one got relative to the one wanted. int 0 is a
+             * drive that never started reading. A large negative d is a
+             * drive reading well before the target. 32767 means the
+             * ring stayed empty for the whole attempt, and int 65535
+             * that no fetch has timed out at all. */
+            DLOG(" timeout: int %u  d %d\r\n", lints, lshort);
             /* Phase one of the timeshare: is the machine's own CDBIOS
              * still up there in Word RAM, and does it execute when
              * exchanged back into low memory? CDBCHK is the smallest
@@ -1139,21 +1221,31 @@ void biosmain(void)
                 UWORD ctrl, lost;
 
                 segacd_bios_ipath(&i4, &own, &vec4, &ctrl, &lost);
-                cprintf(" CDBIOS probe %04X near %04X far %04X sw %u\r\n",
+                DLOG(" CDBIOS probe %04X near %04X far %04X sw %u\r\n",
                         br, segacd_bios_nearread(), rr,
                         segacd_bios_swaps());
-                cprintf(" i4 %lu/%lu v4 %06lX ctl %04X ls %02X\r\n",
+                DLOG(" i4 %lu/%lu v4 %06lX ctl %04X ls %02X\r\n",
                         own, i4, vec4, ctrl, lost);
                 {   /* The one exchange that matters, in full. */
                     ULONG st, cm;
                     UWORD ctl2;
 
                     segacd_bios_cdd(&st, &cm, &ctl2);
-                    cprintf(" st %08lX cm %08lX x %04X\r\n",
+                    DLOG(" st %08lX cm %08lX x %04X\r\n",
                             st, cm, ctl2);
                 }
             }
-            cprintf("\r\n");
+            DLOG("\r\n");
+
+            /* Then put the round somewhere that survives a power cut.
+             * The return code goes on screen only: it changes every
+             * round and would double the size of the file. */
+            if (!cdlog_full) {
+                LONG lrc = cdlog_save();
+                cprintf(" log %ld  bram %u\r\n", lrc, segacd_bram_state());
+            } else {
+                cprintf(" LOG FULL -- safe to power off\r\n");
+            }
 
             /* Long enough to read a round before the next scrolls it
              * away, and long enough that the drive is not being flogged
diff --git a/bios/segacd.c b/bios/segacd.c
index d690e89..b03f763 100644
--- a/bios/segacd.c
+++ b/bios/segacd.c
@@ -251,6 +251,25 @@ static UWORD cd_why;            /* nibble per attempt of the last
                                  * failed fetch: 1 timed out, 2 the
                                  * head was already past, 3 the
                                  * transfer itself failed */
+/* What nibble 1 means, which it has never said.
+ *
+ * The first log to come off a console read 1111 in every round: four
+ * attempts, four timeouts, and not one 2, 3 or 5 anywhere. That rules
+ * out everything this driver was built to survive -- the head being
+ * past, the transfer failing, the decoder mispairing a header -- and
+ * leaves two possibilities that look identical in cd_why and need
+ * opposite fixes. Either the decoder produced nothing at all, meaning
+ * the read never reached the drive; or it produced sectors that never
+ * got as far as the one wanted, meaning the drive is reading in the
+ * wrong place. These two numbers are the difference. */
+static UWORD cd_lastints = 0xFFFF;      /* decoder interrupts during the
+                                 * attempt that gave up: zero is a deaf
+                                 * drive, and 0xFFFF is no timeout yet --
+                                 * cdc_ints is a byte, so it cannot
+                                 * collide with a real count */
+static WORD cd_lastshort = 0x7FFF;      /* newest sector the ring saw,
+                                 * minus the one wanted; 0x7FFF if it
+                                 * saw none */
 static UWORD cd_seeks, cd_hits; /* seeks against sectors simply waited for */
 /* The sector ring.
  *
@@ -1957,6 +1976,21 @@ rewait:
          * attempt, newest in the low bits. 1 timed out, 2 the stream
          * was already past, 3 the transfer failed, 4 the drive's state
          * said to stop asking. */
+        /* Photograph the two numbers before the next attempt resets the
+         * ring, and only for a timeout -- the other verdicts already
+         * name themselves. */
+        if (!why1) {
+            cd_lastints = cdc_ints;
+            if (cd_ring_newest == 0xFFFFFFFFUL) {
+                cd_lastshort = 0x7FFF;
+            } else {
+                LONG d = (LONG)cd_ring_newest - (LONG)lba;
+
+                if (d > 9999L) d = 9999L;
+                if (d < -9999L) d = -9999L;
+                cd_lastshort = (WORD)d;
+            }
+        }
         cd_why = (UWORD)((cd_why << 4) | (why1 ? why1 : 1));
         continue;
 
@@ -2595,8 +2629,10 @@ void segacd_cd_stats(UWORD *seeks, UWORD *hits, UWORD *errs,
                      UBYTE *state, UWORD *why, UWORD *bad, UWORD *wrong,
                      UWORD *torn, UWORD *flag, WORD *wdelta, UWORD *fix,
                      UWORD *flba, UWORD *fsame, UWORD *ts, UWORD *tsf,
-                     UWORD *tsrc)
+                     UWORD *tsrc, UWORD *lints, WORD *lshort)
 {
+    *lints = cd_lastints;
+    *lshort = cd_lastshort;
     *ts = cd_ts ? cd_ts_reads : 0xFFFF;
     *tsf = cd_ts_fails;
     *tsrc = cd_ts_rc;
@@ -3166,6 +3202,15 @@ static void bram_probe(void)
     bram_state = BRAM_OURS;
 }
 
+/* 0 no backup RAM, 1 ours, 2 somebody's game saves -- and 3 if a RAM
+ * cart answered, in which case B: is the cart and none of this applies.
+ * The diagnostic's log has nowhere to go in states 0 and 2, and
+ * "Fcreate -2" on its own does not say which. */
+UBYTE segacd_bram_state(void)
+{
+    return cart_sectors ? 3 : bram_state;
+}
+
 /* Read back the bytes GEMDOS's getbpb depends on, so the status line can
  * show whether the filesystem we wrote is actually there. Expect 0x6010:
  * 0x60 = the boot sector's first byte, 0x10 = 16 total sectors. */
