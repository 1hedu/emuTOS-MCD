diff --git a/bios/segacd2.S b/bios/segacd2.S
index 9dac982..13b2c04 100644
--- a/bios/segacd2.S
+++ b/bios/segacd2.S
@@ -209,8 +209,157 @@ bios_xchg:
         .data
 _segacd_bios_swapcnt:
         .word   0
+_bios_woken:
+        .byte   0
+        .even
         .text
 
+// WORD segacd_bios_read(ULONG lba, WORD count)
+//
+// A real read, done by the machine's own firmware. Returns 0 on
+// success; the sectors land at 0x7D000.
+//
+// This is the part a synchronous probe could not prove: ROMREADN does
+// not read anything by itself, it starts the drive and then makes
+// progress on the drive's own interrupts. So the BIOS's vectors must
+// be live AND the gate array's interrupt mask must let levels 4 and 5
+// through while its code is in low memory -- Sega's handlers, driving
+// Sega's state machine, exactly as they did before eviction.
+//
+// Levels 2 and 3 stay masked for the duration. Level 2 is the
+// servant's frame interrupt and level 3 EmuTOS's tick; with Sega's
+// vector table installed both would run Sega's handlers against
+// EmuTOS's parked variables.
+//
+// Scratch -- stack at 0x7C900, packet at 0x7C000, buffer at 0x7D000 --
+// is above phystop and outside the exchanged region, the only memory
+// on this machine that is both.
+        .globl  _segacd_bios_read
+_segacd_bios_read:
+        move.l  4(sp),d0                // lba
+        move.w  8(sp),d1                // sector count
+        movem.l d1-d7/a0-a6,-(sp)
+        move.w  sr,-(sp)
+        ori.w   #0x0700,sr              // no interrupts across the swap
+        move.b  0xFF8033,d7             // EmuTOS's gate-array mask
+        ext.w   d7
+
+        move.l  sp,a6
+        move.l  #0x7C900,sp             // scratch stack, outside the swap
+
+        movem.l d0-d1/d7,-(sp)
+        bsr     bios_xchg               // Sega's world into low memory
+        movem.l (sp)+,d0-d1/d7
+
+        lea     0x7C000,a5
+        move.l  d0,(a5)                 // start sector
+        ext.l   d1
+        move.l  d1,4(a5)                // sector count
+        move.l  #0x7D000,8(a5)          // destination
+
+        move.b  #0x30,0xFF8033          // CDD and CDC interrupts, nothing else
+        andi.w  #0xF8FF,sr              // clear ALL THREE mask bits --
+        ori.w   #0x0300,sr              // 0xFCFF left bit 10 set, so the
+                                        // ori put it straight back to 7
+                                        // and Sega's handlers never ran
+
+        // Wake the firmware before asking it for anything.
+        //
+        // Its internal state is frozen from the instant of eviction --
+        // half an hour and several thousand of our own drive commands
+        // ago -- so it believes the drive is wherever it last left it
+        // and mid-whatever it was doing. DRV_INIT is how a Sega program
+        // starts a session: read the TOC from track 1, all tracks, and
+        // establish where the disc actually is. It is asynchronous, so
+        // the wait for readiness is on CDB_STAT afterwards.
+        tst.b   _bios_woken
+        bne     brd_awake
+        move.b  #1,0x7C010              // first track
+        move.b  #0xFF,0x7C011           // ...through the last
+        lea     0x7C010,a0
+        move.w  #0x0010,d0              // DRV_INIT
+        jsr     0x5F22
+        move.l  #200000,d4
+brd_wait_init:
+        subq.l  #1,d4
+        jeq     brd_fail_init
+        move.w  #0x0081,d0              // CDB_STAT
+        jsr     0x5F22
+        move.w  (a0),d3                 // status word: low byte is the
+        andi.w  #0x00FF,d3              //  drive state the BIOS believes
+        cmpi.w  #0x0004,d3              // 4 = paused, ready to be read
+        beq     brd_init_done
+        cmpi.w  #0x0001,d3              // 1 = playing, also fine
+        bne     brd_wait_init
+brd_init_done:
+        move.b  #1,_bios_woken
+brd_awake:
+
+        movea.l a5,a0
+        move.w  #0x0089,d0              // CDCSTOP
+        jsr     0x5F22
+        movea.l a5,a0
+        move.w  #0x0020,d0              // ROMREADN
+        jsr     0x5F22
+
+        move.l  #150000,d6              // overall bound; the drive is the
+                                        // clock, but a dead link is not
+brd_stat:
+        subq.l  #1,d6
+        jeq     brd_fail_stat
+        move.w  #0x008A,d0              // CDCSTAT
+        jsr     0x5F22
+        bcs     brd_stat                // no sector ready yet
+brd_read:
+        subq.l  #1,d6
+        jeq     brd_fail_read
+        move.w  #0x008B,d0              // CDCREAD
+        jsr     0x5F22
+        bcc     brd_read
+        movea.l 8(a5),a0                // where this sector goes
+        lea     12(a5),a1               // header scratch
+        move.w  #0x008C,d0              // CDCTRN
+        jsr     0x5F22
+        bcc     brd_read                // transfer incomplete, go again
+        move.w  #0x008D,d0              // CDCACK
+        jsr     0x5F22
+        addq.l  #1,(a5)                 // next sector
+        addi.l  #0x0800,8(a5)
+        subq.l  #1,4(a5)
+        bne     brd_stat
+        moveq   #0,d5                   // every sector delivered
+        bra     brd_done
+        // Each stage names itself, because "it did not work" has cost
+        // enough already: 2 the firmware never reported itself ready,
+        // 3 no sector was ever announced, 4 one was announced and never
+        // came out. Low byte carries the drive state the BIOS believed.
+brd_fail_init:
+        moveq   #2,d5
+        bra     brd_failed
+brd_fail_stat:
+        moveq   #3,d5
+        bra     brd_failed
+brd_fail_read:
+        moveq   #4,d5
+brd_failed:
+        lsl.w   #8,d5
+        or.w    d3,d5
+brd_done:
+        ori.w   #0x0700,sr              // shut the door before swapping back
+        move.b  #0,0xFF8033
+        move.l  d5,-(sp)
+        move.l  d7,-(sp)
+        bsr     bios_xchg               // EmuTOS's world back into place
+        move.l  (sp)+,d7
+        move.l  (sp)+,d5
+        move.b  d7,0xFF8033             // EmuTOS's mask, as we found it
+
+        move.l  a6,sp
+        move.w  (sp)+,sr
+        movem.l (sp)+,d1-d7/a0-a6
+        move.w  d5,d0
+        rts
+
 // Level 3: gate array timer, 200 Hz system tick
         .globl  _segacd_int_3
 _segacd_int_3:
