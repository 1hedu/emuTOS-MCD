@@ -2298,6 +2298,37 @@ static BOOL bios_parked(void)
 WORD segacd_bios_call(WORD fn);         /* segacd2.S */
 extern UWORD segacd_bios_swapcnt;       /* segacd2.S */
 
+WORD segacd_bios_read(ULONG lba, WORD count);   /* segacd2.S */
+
+/* Phase two: does the parked firmware actually READ?
+ *
+ * The pattern sector is the right target because the answer needs no
+ * reference data -- the driver regenerates those 2048 bytes from a
+ * formula, so a match is proof and not a coincidence. Returns 0 for a
+ * verified read, 1 for a read that failed, 2 for a read that returned
+ * the wrong bytes, 0xFFFF for no firmware parked. */
+UWORD segacd_bios_readtest(void)
+{
+    const UBYTE *got = (const UBYTE *)0x7D000UL;
+    UWORD i;
+
+    if (!bios_parked())
+        return 0xFFFF;
+
+    {   /* Pass the stage code through. Collapsing it to 1 here threw
+         * away the only thing the read had to say. */
+        WORD rc = segacd_bios_read(CDR_PATTERN_LBA, 1);
+
+        if (rc)
+            return (UWORD)rc;
+    }
+
+    for (i = 0; i < CDC_DATA_BYTES; i++)
+        if (got[i] != (UBYTE)(((i * 5) ^ (i >> 4) ^ 0xA5) & 0xFF))
+            return 2;
+    return 0;
+}
+
