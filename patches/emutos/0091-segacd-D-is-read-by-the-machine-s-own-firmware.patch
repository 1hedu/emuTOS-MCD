+void segacd_bios_selftest(void);
+WORD segacd_bios_read(ULONG lba, WORD count);
 UWORD segacd_bios_swaps(void);
 extern UWORD segacd_bootflags;  /* raw boot-button word, for printing */
 void segacd_cd_tune(UWORD lead, UWORD hold, UWORD late);
