+    w[4] = (UWORD)((nib[8] << 8) | ck);
+}
+
+static void cdd_load_bytes(const UBYTE *nib, UBYTE ck)
+{
+    int i;
+
+    for (i = 0; i < 9; i++)
+        CDD_CMD[i] = nib[i];
+    CDD_CMD[9] = ck;            /* last, in case this write is the trigger */
+}
+
+static void cdd_command(const UBYTE *nib)       /* nine nibbles */
+{
+    UBYTE ck, sum = 0;
+    int i;
+
+    for (i = 0; i < 9; i++)
+        sum = (UBYTE)(sum + nib[i]);
+    ck = (UBYTE)((~sum) & 0x0F);
+
+    switch (cdd_strat) {
+    default:
+    case 0:                             /* words; the last write is it */
+        cdd_load_words(nib, ck);
+        break;
+    case 1:                             /* words, then set HOCK again */
+        cdd_load_words(nib, ck);
+        *CDD_CTRL = CDD_HOCK;
+        break;
+    case 2:                             /* words, then a real HOCK edge */
+        cdd_load_words(nib, ck);
+        *CDD_CTRL = 0;
+        *CDD_CTRL = CDD_HOCK;
+        break;
+    case 3:                             /* loaded with the clock stopped */
         *CDD_CTRL = 0;
+        cdd_load_words(nib, ck);
         *CDD_CTRL = CDD_HOCK;
+        break;
+    case 4:                             /* bytes; the last write is it */
+        cdd_load_bytes(nib, ck);
+        break;
+    case 5:                             /* bytes, then a real HOCK edge */
+        cdd_load_bytes(nib, ck);
+        *CDD_CTRL = 0;
+        *CDD_CTRL = CDD_HOCK;
+        break;
     }
 
