+/* Until something is known to work, every command is an experiment.
+ *
+ * The drive decides, not me: a strategy counts as working only when the
+ * reply names the sub-command it was asked for, and only after it has
+ * done that for two *different* sub-commands -- one match could be a
+ * default value sitting in the register. Ask for the total disc length
+ * and then the current track, since 3 and 2 are values nothing would
+ * report by accident.
+ *
+ * Eight unanswered attempts and the next strategy gets its turn. If all
+ * six go round without a single answer, that is a real result and not a
+ * blank one: it rules out the trigger being a write we are performing
+ * in the wrong order or the wrong width, and points somewhere else
+ * entirely. */
+static void cdd_search(void)
+{
+    static const UBYTE ask[2] = { 0x03, 0x02 };
+
+    if (cdd_answered) {                 /* the reply named what we asked */
+        if (cdd_hits < 2 && cdd_want != cdd_hitsub) {
+            cdd_hitsub = cdd_want;
+            if (++cdd_hits >= 2)
+                cdd_won = cdd_strat;    /* twice, on two questions: keep it */
+        }
+    } else if (++cdd_tries >= 8) {      /* this one has had its chance */
+        cdd_tries = 0;
+        cdd_hits = 0;
+        cdd_hitsub = 0xFF;
+        if (++cdd_strat >= CDD_NSTRAT)
+            cdd_strat = 0;
+    }
+
+    cdd_ask(CDD_CMD_INFO, ask[cdd_alt ^= 1]);
+}
+
+static void cdd_ask_next(void)
+{
+    if (cdd_won == CDD_NOWIN) {
+        cdd_search();
+        return;
+    }
+
+    cdd_ask(cdd_probes[cdd_probe][0], cdd_probes[cdd_probe][1]);
 
     if (++cdd_probe >= CDD_NPROBES)
         cdd_probe = 0;
@@ -280,6 +373,12 @@ static void cdd_poll(void)
     for (i = 0; i < 9; i++)
         sum = (UBYTE)(sum + cdd_stat[i]);
     cdd_valid = (UBYTE)((((~sum) & 0x0F) == cdd_stat[9]) ? 1 : 0);
+
+    /* The only evidence that a command arrived: the drive naming the
+     * sub-command it was asked for. Checked on every packet, because
+     * the reply may be a packet or two behind the request. */
+    if (cdd_valid && cdd_stat[0] != 0x0F && cdd_stat[1] == cdd_want)
+        cdd_answered = 1;
 }
 
