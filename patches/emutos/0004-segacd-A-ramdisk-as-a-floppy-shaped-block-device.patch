+/******************************************************************************/
+/* Floppy-shaped block devices                                                */
+/******************************************************************************/
+
+/* A: is a FAT12 image the boot loader reads from the CD into PRG-RAM
+ * bank 3 — plain memory to us. Geometry lives in its own boot sector;
+ * we only do linear sector math (16 sectors/track, 1 side, 512 bytes). */
+
+#define ADISK_BASE  ((UBYTE *)0x60000)
+#define ADISK_SECTORS 256
+
+static BOOL adisk_present;
+
+void segacd_floppy_init(void)
+{
+    /* the builder stamps "EmuTOSMD" as the OEM field at offset 2 */
+    adisk_present = (ADISK_BASE[2] == 'E' && ADISK_BASE[3] == 'm'
+                  && ADISK_BASE[4] == 'u' && ADISK_BASE[5] == 'T');
+}
+
+BOOL segacd_flop_detect_drive(WORD dev)
+{
+    if (dev == 0)
+        return adisk_present;
+    return FALSE;               /* B: arrives with the cart proxy */
+}
+
+LONG segacd_flop_mediach(WORD dev)
+{
+    MAYBE_UNUSED(dev);
+    return MEDIANOCHANGE;
+}
+
+WORD segacd_floprw(UBYTE *buf, WORD rw, WORD dev, WORD sect, WORD track,
+                   WORD side, WORD count)
+{
+    LONG lba;
+    UBYTE *p;
+
+    if (dev != 0 || !adisk_present)
+        return EUNDEV;
+
+    lba = (LONG)track * 16 + (sect - 1);
+    MAYBE_UNUSED(side);
+    if (lba < 0 || lba + count > ADISK_SECTORS)
+        return ESECNF;
+
+    p = ADISK_BASE + lba * SECTOR_SIZE;
+    if (rw & 1)
+        memcpy(p, buf, (LONG)count * SECTOR_SIZE);   /* volatile but writable */
+    else
+        memcpy(buf, p, (LONG)count * SECTOR_SIZE);
+    return E_OK;
+}
+
 /******************************************************************************/
 /* Keyboard                                                                   */
 /******************************************************************************/
diff --git a/bios/segacd.h b/bios/segacd.h
index ddc280e..c4d8163 100644
--- a/bios/segacd.h
+++ b/bios/segacd.h
@@ -26,6 +26,14 @@ void segacd_kbd_init(void);
 /* Clock */
 ULONG segacd_getdt(void);
 
+/* Floppy-shaped block devices: A: = CD-loaded ramdisk in PRG bank 3,
+ * B: = backup RAM cartridge via the main-CPU servant (when present) */
+void segacd_floppy_init(void);
+BOOL segacd_flop_detect_drive(WORD dev);
+LONG segacd_flop_mediach(WORD dev);
+WORD segacd_floprw(UBYTE *buf, WORD rw, WORD dev, WORD sect, WORD track,
+                   WORD side, WORD count);
+
 /* Interrupt handlers (assembler entry points in segacd2.S) */
 void segacd_int_2(void);        /* INT2: VBL, raised by the main CPU */
 void segacd_int_3(void);        /* INT3: gate array timer, 200 Hz */
