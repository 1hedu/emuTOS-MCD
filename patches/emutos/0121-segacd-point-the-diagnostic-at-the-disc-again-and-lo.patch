+                     UBYTE *h3first, UWORD *h3same)
 {
     *lints = cd_lastints;
     *lshort = cd_lastshort;
     *badmode = cd_badmode;
     *lasth3 = cd_lasth3;
+    *h3first = cd_h3first;
+    *h3same = cd_h3same;
     *ts = cd_ts ? cd_ts_reads : 0xFFFF;
     *tsf = cd_ts_fails;
     *tsrc = cd_ts_rc;
@@ -3153,6 +3171,15 @@ void segacd_cd_probe(UWORD *ringok, ULONG *newest, UWORD *dsr, UWORD *edt,
  * what it set. Nothing about a normal boot goes through here. */
 void segacd_cd_tune(UWORD lead, UWORD hold, UWORD late)
 {
+    /* The diagnostic is not a boot, and only the diagnostic calls this.
+     *
+     * cd_booting exists so a drive that cannot answer costs a desktop
+     * an icon instead of a minute, and it is cleared by deskmain() --
+     * which the diagnostic runs *instead of*. So without this the whole
+     * diagnostic would run on the boot leash: two seconds a read and no
+     * retry, on the one screen in this system whose entire purpose is
+     * to give the drive every chance and report what happened. */
+    cd_booting = 0;
     cd_lead = lead;
     cd_hold = (UBYTE)(hold ? 1 : 0);
     cd_late = (UBYTE)(late ? 1 : 0);
@@ -3936,7 +3963,7 @@ LONG segacd_cart_ioctl(WORD op, void *arg)
         info[1] = SECTOR_SIZE;
         return E_OK;
     case GET_DISKNAME:
-        strcpy((char *)arg, "Cartridge save RAM");
+        strcpy((char *)arg, "Cart");
         return E_OK;
     case GET_MEDIACHANGE:
         /* A cartridge cannot be changed with the power on, and the
