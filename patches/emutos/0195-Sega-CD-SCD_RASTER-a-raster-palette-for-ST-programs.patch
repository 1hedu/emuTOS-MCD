From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: emuTOS-MCD <darekadumon@gmail.com>
Date: Tue, 6 Oct 2026 05:45:04 +0000
Subject: [PATCH 195/196] Sega CD: SCD_RASTER, a raster palette for ST programs

An ST program gets more than sixteen colours on screen by reprogramming
the palette partway down it from MFP Timer B: a paint program's colour
picker, a game's status panel. There is no Timer B here and the palette
is on the other CPU, so a program now describes the changes instead --
a table of (ST line, colour mask, colours) -- and hands it over with
scd_api.control(SCD_RASTER, table). The servant makes the changes from
the VDP's line interrupt.

EmuTOS's part is small: it keeps the table's address and, at each VBL,
writes "RST!", the table's generation and its address beside the screen
on display (+32240, inside the 32256 a screen keeps clear for the
blocks), the same way the palette and pointer blocks go there. The
desktop clears it when it starts, so a program that dies holding one
leaves nothing behind. API version 36.
---
 bios/scdapi.h | 28 +++++++++++++++++++++++-
 bios/segacd.c | 60 ++++++++++++++++++++++++++++++++++++++++++++++++++-
 bios/segacd.h |  1 +
 3 files changed, 87 insertions(+), 2 deletions(-)

diff --git a/bios/scdapi.h b/bios/scdapi.h
index 0cbf7a7..92ef7f3 100644
--- a/bios/scdapi.h
+++ b/bios/scdapi.h
@@ -28,7 +28,7 @@
 #define SCDAPI_H
 
 #define SCD_COOKIE   0x53674344L        /* 'SgCD' */
-#define SCD_VERSION  35
+#define SCD_VERSION  36
 
 /* Everything the disc diagnostic prints, in one go. Taken in a single
  * call rather than twenty accessors so that the numbers in one report
@@ -286,6 +286,32 @@ struct brmcall {
 #define SCD_BRAM_CALL     20
 #define SCD_CARTSWAP      11            /* Mode 1: expect the cartridge to
                                          * be pulled and another put in */
+/* A raster palette: colours that change partway down the screen, as an
+ * ST program gets them by reprogramming the shifter from MFP Timer B.
+ * There is no Timer B here, and the palette lives on the other CPU, so
+ * the program describes the changes instead and the servant makes them
+ * from the Genesis VDP's line interrupt.
+ *
+ * a points at a struct scd_raster in the program's own memory, which
+ * must stay put until the program calls this again with a = 0. The
+ * servant reads it whenever gen changes, so a program that changes the
+ * table bumps gen afterwards. Returns E_OK, or EBADRQ for an address
+ * that cannot be a table. The desktop clears it when it starts, so a
+ * program that dies holding one does not leave the next screen striped.
+ *
+ * Each entry says that from ST line `line` (1..199) down, the colours
+ * whose bits are set in `mask` are the ones that follow, lowest colour
+ * first, as 0x0RGB words. Lines must ascend. The top of every frame is
+ * the ordinary palette, as Setpalette left it. At most SCD_RASTER_MAX
+ * entries, and SCD_RASTER_WORDS words of entries in all. */
+#define SCD_RASTER        21
+#define SCD_RASTER_MAX    32
+#define SCD_RASTER_WORDS  560
+struct scd_raster {
+    unsigned short gen;
+    unsigned short count;
+    unsigned short words[1];    /* entries: line, mask, colours... */
+};
 
 /* Where the servant publishes the controller, for programs that have to
  * read it directly.
diff --git a/bios/segacd.c b/bios/segacd.c
index 796459b..e2fb458 100644
--- a/bios/segacd.c
+++ b/bios/segacd.c
@@ -508,14 +508,17 @@ static BOOL adisk_present;      /* forward: the level 4 handler publishes it */
  *   bit 4  deskmain() entered
  */
 static UBYTE cd_events;
+static ULONG ras_table;         /* SCD_RASTER's table, below */
 
 void segacd_event(UWORD bit)
 {
     cd_events |= (UBYTE)(1u << bit);
     /* deskmain() is the end of the boot, and the only place in the
      * system that knows it. The CD's short boot leash ends here. */
-    if (bit == 4)
+    if (bit == 4) {
         cd_boot_over();
+        ras_table = 0;          /* a raster left by a program that died */
+    }
 }
 
 static UWORD cd_wsum = 0xFFFF;  /* 0xFFFF = not computed yet */
@@ -3378,6 +3381,59 @@ static void cd_boot_over(void)
     cd_booting = 0;
 }
 
+/* The raster palette: SCD_RASTER in scdapi.h. EmuTOS only says where
+ * the program's table is; the servant reads it and does the work. The
+ * pointer goes in a block beside the screen on display, after the
+ * others there, where the servant reads it in the grab it already
+ * holds for the palette:
+ *
+ *   +32240  "RS" "T!", the table's generation, its address (two words)
+ *
+ * 32240 + 10 is inside the 32256 a screen needs to keep the blocks
+ * clear of whatever follows it. Written only when something changed --
+ * the screen on display, the table, or its generation -- and so also
+ * written again whenever a screen comes back on display, which keeps a
+ * stale block on a screen that was away from pointing at anything. */
+#define RASBLK_OFF  32240UL
+static const UBYTE *ras_where;
+static ULONG ras_said;
+static UWORD ras_gen_said;
+
+ULONG segacd_raster(ULONG table)
+{
+    if (table && (table & 1 || table < 0x1000UL || table >= 0x80000UL))
+        return (ULONG)EBADRQ;
+    ras_table = table;
+    return E_OK;
+}
+
+static void scd_ras_vbl(void)
+{
+    const UBYTE *shown = segacd_shown();
+    volatile UWORD *rb = (volatile UWORD *)(shown + RASBLK_OFF);
+    UWORD gen = ras_table ? *(const UWORD *)ras_table : 0;
+
+    if (shown == ras_where && ras_table == ras_said && gen == ras_gen_said)
+        return;
+    if (ras_table) {
+        rb[2] = gen;
+        rb[3] = (UWORD)(ras_table >> 16);
+        rb[4] = (UWORD)ras_table;
+        rb[0] = 0x5253;                 /* "RS", last: the rest is there */
+        rb[1] = 0x5421;                 /* "T!" */
+    } else if (ras_where == shown && ras_said) {
+        rb[0] = 0;                      /* gone */
+    } else if (ras_where != shown) {
+        /* A screen this has never written to, or not since: whatever
+         * is at the offset is not ours, and must not read as a block. */
+        if (rb[0] == 0x5253 && rb[1] == 0x5421)
+            rb[0] = 0;
+    }
+    ras_where = shown;
+    ras_said = ras_table;
+    ras_gen_said = gen;
+}
+
 /* The AES is starting an autorun program in place of the desktop. That
  * program is the first thing after the boot, as deskmain() would be. */
 void segacd_autorun(void)
@@ -4069,6 +4125,7 @@ static ULONG scd_control(LONG op, LONG a, LONG b, LONG c)
     case SCD_BIOS_NEARREAD: return segacd_bios_nearread();
     case SCD_BRAM_INFO:     return segacd_buram_info(a != 0);
     case SCD_BRAM_CALL:     return segacd_buram_pass((struct brmcall *)a);
+    case SCD_RASTER:        return segacd_raster((ULONG)a);
     case SCD_BIOS_SWAPS:    return segacd_bios_swaps();
     }
     return 0;
@@ -4629,6 +4686,7 @@ void segacd_int_2_c(void)
     *(volatile UWORD *)0xFF8020 = (UWORD)(((ULONG)segacd_shown()) >> 8);
 
     scd_pal_vbl();
+    scd_ras_vbl();
     int_vbl();
 }
 
diff --git a/bios/segacd.h b/bios/segacd.h
index 2f6d424..a1b8f4c 100644
--- a/bios/segacd.h
+++ b/bios/segacd.h
@@ -25,6 +25,7 @@ void segacd_setphys(const UBYTE *addr);
 const UBYTE *segacd_physbase(void);
 UBYTE *segacd_shown(void);         /* the screen the servant shows */
 void segacd_autorun(void);         /* the AES starts an autorun program */
+ULONG segacd_raster(ULONG table);  /* SCD_RASTER: a raster palette */
 WORD segacd_setcolor(WORD colorNum, WORD color);
 
 /* System timer (gate array INT3) */
