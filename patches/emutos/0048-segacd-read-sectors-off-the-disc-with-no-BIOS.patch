 /******************************************************************************/
@@ -76,6 +77,56 @@ _segacd_cdd_put:
         move.w  (a0)+,(a1)+
         rts
 
+// Level 5: the CDC has finished decoding a sector, 75 Hz while the drive
+// is reading. No SR write: the 68000 has already masked to level 5 on
+// entry, and the BIOS's own handler at $064C does not raise it either --
+// which matters, because this must not lock out level 6 or 7.
+        .globl  _segacd_int_5
+_segacd_int_5:
+        movem.l d0-d1/a0-a1,-(sp)
+        jbsr    _segacd_int_5_c         // Delegate to C implementation
+        movem.l (sp)+,d0-d1/a0-a1
+        rte
+
+// The bulk sector read, as instructions, for the same reason the CDD
+// transfers above are: this is CDCTRN's inner loop ($1DE2 and $1E2A) and
+// the pacing is part of it. Sega puts a nop between every read of the
+// host data register and unrolls by eight, and neither is decoration --
+// the gate array is refilling a FIFO from buffer RAM between them.
+//
+// void segacd_cdc_read(UWORD *hdr, UWORD *data, LONG groups)
+//   hdr   <- two words, the sector's M/S/F/mode header
+//   data  <- (groups+1) * 8 words
+        .globl  _segacd_cdc_read
+_segacd_cdc_read:
+        move.l  4(sp),a1                // header destination
+        move.l  8(sp),a0                // data destination
+        move.w  14(sp),d1               // low word of the long count
+        move.l  a2,-(sp)
+        lea     0xFF8008,a2
+        move.w  (a2),(a1)+
+        nop
+        move.w  (a2),(a1)+
+1:      move.w  (a2),(a0)+
+        nop
+        move.w  (a2),(a0)+
+        nop
+        move.w  (a2),(a0)+
+        nop
+        move.w  (a2),(a0)+
+        nop
+        move.w  (a2),(a0)+
+        nop
+        move.w  (a2),(a0)+
+        nop
+        move.w  (a2),(a0)+
+        nop
+        move.w  (a2),(a0)+
+        nop
+        dbra    d1,1b
+        move.l  (sp)+,a2
+        rts
+
 // Level 3: gate array timer, 200 Hz system tick
         .globl  _segacd_int_3
 _segacd_int_3:
