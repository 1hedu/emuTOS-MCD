@@ -46,10 +46,13 @@ WORD segacd_floprw(UBYTE *buf, WORD rw, WORD dev, WORD sect, WORD track,
 void segacd_int_2(void);        /* INT2: VBL, raised by the main CPU */
 void segacd_int_3(void);        /* INT3: gate array timer, 200 Hz */
 void segacd_int_4(void);        /* INT4: CDD status packet, 75 Hz */
+void segacd_int_5(void);        /* INT5: CDC decoded a sector, 75 Hz */
 void segacd_int_2_c(void);
 void segacd_int_4_c(void);
+void segacd_int_5_c(void);
 void segacd_cdd_fetch(UBYTE *dst);      /* ten status bytes, BIOS form */
