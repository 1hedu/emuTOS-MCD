     }
 }
 
+/******************************************************************************/
+/* D: -- the filesystem that stays on the disc                                */
+/******************************************************************************/
+
+/* Stage 3 read one sector and stopped. A mounted drive asks for
+ * arbitrary ones, on demand, from GEMDOS context -- so the same
+ * machinery has to be usable as a plain blocking call, and it has to be
+ * fast enough to be worth having.
+ *
+ * Two things make it fast enough. A CD sector is 2048 bytes and a
+ * GEMDOS block is 512, so four consecutive blocks come out of one
+ * cached sector. And the drive, once reading, delivers the next sector
+ * every 1/75 s all by itself -- so as long as the next thing asked for
+ * is ahead of the head and not far ahead, waiting beats seeking. A seek
+ * is the better part of a second; a sector is thirteen milliseconds.
+ * Re-seeking per block would be about four seconds for every two
+ * kilobytes, which is not a disk, it is a punishment. */
+
+#define CD_DDISK_LBA    1600UL          /* where the image sits on the disc */
+#define CD_DDISK_BLOCKS 8192UL          /* 4 MB in 512-byte blocks */
+#define CD_BPS_SHIFT    2               /* 2048 / 512 */
+
+/* How far ahead we are willing to wait rather than seek. Twenty sectors
+ * is a quarter of a second of streaming, against most of a second for a
+ * seek -- and reading forward is what the drive is already doing. */
+#define CD_STREAM_AHEAD 20UL
+
+
+/* Wait, with interrupts running, for the sector whose header we have
+ * already asked for. Returns false on timeout.
+ *
+ * This spins in foreground code and that is deliberate: level 5 is what
+ * notices the sector and level 5 cannot run inside itself. A GEMDOS
+ * read blocking for a few frames is what a floppy does too. */
+static BOOL cd_wait_hit(void)
+{
+    ULONG spin;
+
+    /* Bounded by a count rather than by the 200 Hz tick, because a
+     * mount can happen before that tick exists. Long enough for a seek
+     * and a spin-up -- a couple of seconds -- and irrelevant to the
+     * common case, where the sector is already on its way and arrives
+     * within thirteen milliseconds. */
+    for (spin = 0; spin < 6000000UL; spin++) {
+        if (cdc_hit)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+/* Put the drive at a sector and take it. Everything here is stage 3's,
+ * only called from the foreground instead of from the VBL. */
+static BOOL cd_fetch(ULONG lba)
+{
+    UBYTE start[3];
+    int attempt;
+
+    lba_to_msf(lba, cdc_want);
+
+    for (attempt = 0; attempt < 3; attempt++) {
+        if (!cd_streaming || lba < cd_next || lba > cd_next + CD_STREAM_AHEAD) {
+            /* Out of reach of the stream: seek. */
+            cdc_hit = 0;
+            cdc_ints = 0;
+            cdc_setup();
+            lba_to_msf(lba >= CDR_LEADIN ? lba - CDR_LEADIN : 0, start);
+            cdd_ask_read(start);
+            cd_streaming = 1;
+            cd_seeks++;
+        } else {
+            cdc_hit = 0;                /* it is coming; just wait for it */
+            cd_hits++;
+        }
+
+        if (cd_wait_hit()) {
+            /* The drive is reading. Stop telling it to start, or the
+             * same "begin at this position" command goes out seventy-five
+             * times a second for as long as D: is mounted -- which is
+             * the stage 2 lesson upside down: the conversation needs a
+             * turn every exchange, but it needs the *right* turn, and
+             * repeating a seek for ever is not it. */
+            cdd_ask_idle();
+            if (cdc_grab()) {
+                cd_cached = lba;
+                cd_next = lba + 1;
+                return TRUE;
+            }
+        }
+
+        /* Whatever went wrong, the stream is no longer trustworthy. */
+        cd_streaming = 0;
+    }
+
+    cd_errors++;
+    cd_cached = 0xFFFFFFFFUL;
+    return FALSE;
+}
+
+/* One 512-byte block of D:, from the CD sector that contains it. */
+static BOOL cd_read_block(ULONG block, UBYTE *buf)
+{
+    ULONG lba = CD_DDISK_LBA + (block >> CD_BPS_SHIFT);
+    UWORD off = (UWORD)((block & ((1U << CD_BPS_SHIFT) - 1)) * SECTOR_SIZE);
+
+    if (cd_cached != lba && !cd_fetch(lba))
+        return FALSE;
+    memcpy(buf, CDSECT + off, SECTOR_SIZE);
+    return TRUE;
+}
+
+/* The block-layer entry point. Read only: it is a compact disc. */
+LONG segacd_cd_rw(WORD rw, LONG sector, WORD count, UBYTE *buf)
+{
+    if (rw & RW_WRITE)
+        return EWRPRO;
+    if (sector < 0 || (ULONG)sector + count > CD_DDISK_BLOCKS)
+        return ESECNF;
+
+    while (count--) {
+        if (!cd_read_block((ULONG)sector, buf))
+            return EREADF;
+        sector++;
+        buf += SECTOR_SIZE;
+    }
+    return E_OK;
+}
+
+/* Does the mounted filesystem actually read?
+ *
+ * The icon appearing on the desktop proves block 0 came off the disc,
+ * and no more than that. This reads the two ends of the image and a
+ * block in the middle, through the same path GEMDOS uses -- so it
+ * exercises the sector cache, the four-blocks-per-sector arithmetic and
+ * the seek-versus-wait decision, none of which block 0 alone touches.
+ *
+ * What it checks is what the builder guarantees: block 0 is a FAT16
+ * boot sector with our OEM name and the 0x55AA signature, and the
+ * blocks past the end of the FAT are the zeroes mkfat.py left there.
+ * Weak evidence on its own; strong beside a pattern sector that already
+ * matched byte for byte. */
+static void cd_selftest(void)
+{
+    static UBYTE buf[SECTOR_SIZE];
+    ULONG probe[3];
+    UBYTE ok = 1;
+    int i;
+
+    probe[0] = 0;
+    probe[1] = CD_DDISK_BLOCKS / 2;
+    probe[2] = CD_DDISK_BLOCKS - 1;
+
+    cd_dtest = 1;
+    for (i = 0; i < 3; i++) {
+        if (!cd_read_block(probe[i], buf)) {
+            ok = 0;
+            break;
+        }
+        if (i == 0) {
+            /* the boot sector the disc builder wrote */
+            if (buf[510] != 0x55 || buf[511] != 0xAA
+                    || buf[2] != 'E' || buf[3] != 'm' || buf[4] != 'u')
+                ok = 0;
+        } else {
+            UWORD k;
+            for (k = 0; k < SECTOR_SIZE; k++)
+                if (buf[k])
+                    ok = 0;
+        }
+    }
+    if (ok)
+        cd_dtest |= 2;
+}
+
+LONG segacd_cd_ioctl(WORD op, void *arg)
+{
+    ULONG *info = (ULONG *)arg;
+
+    switch (op) {
+    case GET_DISKINFO:
+        info[0] = CD_DDISK_BLOCKS;
+        info[1] = SECTOR_SIZE;
+        return E_OK;
+    case GET_DISKNAME:
+        strcpy((char *)arg, "Mega CD disc");
+        return E_OK;
+    case GET_MEDIACHANGE:
+        /* The tray cannot be opened without cutting power to the sub,
+         * which ends EmuTOS along with the question. */
+        return MEDIANOCHANGE;
+    }
+    return ERR;
+}
+
 /******************************************************************************/
 /* Sound: RF5C164 PCM                                                         */
 /******************************************************************************/
@@ -1586,6 +1810,17 @@ void segacd_floppy_init(void)
 {
     segacd_cdd_init();
 
+    /* Check the filesystem on the disc, here, in foreground.
+     *
+     * It was in the VBL to begin with and that was wrong twice over.
+     * The VBL runs at interrupt level 3, so blocking in it for the
+     * seconds a seek takes locks out the 200 Hz tick as well; and the
+     * CDD's storm guard counts drive interrupts between VBLs and
+     * switches level 4 off when it sees too many -- so a VBL that
+     * blocks for thirteen seconds trips a guard designed to catch
+     * runaway re-entry. The console said so: the link score read 'S'. */
+    cd_selftest();
+
     /* the builder stamps "EmuTOSMD" as the OEM field at offset 2 */
     adisk_present = (ADISK_BASE[2] == 'E' && ADISK_BASE[3] == 'm'
                   && ADISK_BASE[4] == 'u' && ADISK_BASE[5] == 'T');
