@@ -571,6 +585,14 @@ static UWORD cdc_spill;         /* words drained while waiting for the end
  * control-register writes is not obviously free. */
 static void cdc_setup(void)
 {
+    /* Whoever re-initialises the decoder is also moving the drive, so
+     * what D: thinks it has cached and where it thinks the head is are
+     * both now fiction. Invalidating here rather than at each call site
