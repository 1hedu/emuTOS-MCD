+/* ---- Sega's own Backup RAM manager --------------------------------------
+ *
+ * Everything above lays a FAT12 volume over the whole of the memory,
+ * which is why a cartridge cannot hold our files and a game's saves at
+ * the same time: the Sega volume's footer is the last 0x40 bytes, and
+ * our filesystem's data area runs straight through it.
+ *
+ * The footer, for reference -- Genesis Plus GX libretro.c `brm_format`,
+ * which is the check every emulator and the BIOS agree on:
+ *
+ *   end-0x40  0x5F x11, 0x00 x4, 0x40
+ *   end-0x30  the free-block count, big-endian, written four times over
+ *   end-0x28  0x00 x8
+ *   end-0x20  "SEGA_CD_ROM\0" 0x01 0x00 0x00 0x00
+ *   end-0x10  "RAM_CARTRIDGE___"
+ *
+ * A volume is Sega's if and only if the last 0x20 bytes match. Blocks
+ * are 0x40 bytes; the count excludes the three the footer occupies.
+ *
+ * None of which this file needs to write, and that is the point of
+ * going through _BURAM: the directory layout, the allocation and the
+ * free count stay Sega's code's problem. We only have to be able to
+ * call it.
+ */
+/* Everything the manager is handed a pointer to goes at a fixed address,
+ * and that is not a style choice.
+ *
+ * The visit exchanges 0..0x6000, so during the call that region holds
+ * EmuTOS's bytes instead of its own. EmuTOS's stack is at 0x800 and its
+ * .bss begins at 0x2140, both inside it -- and segacd.o's own .bss runs
+ * 0x35F8..0x7FF2, which *straddles* the line. A static would therefore
+ * land inside or outside the exchange depending on nothing more than
+ * declaration order, which is not a property to rest correctness on and
+ * is exactly how the printer's page buffer ended up at 0x2140.
+ *
+ * So they go in the region already set aside for this: 0x7C000-0x7EFFF,
+ * "stack, BIOS packet and read buffer for visits to the parked
+ * firmware", above phystop where EmuTOS never allocates. The timeshare
+ * claims 8 KB at 0x7D000 and uses CD_TS_SECTORS of it; this takes the
+ * page at 0x7E000, and the check below is what stops the two ever
+ * meeting quietly. */
+#define BRM_SCRATCH 0x7E000UL
+#if CD_TS_SECTORS * 512 > (BRM_SCRATCH - 0x7D000UL)
+#error "the timeshare's read buffer now reaches the BRAM work area"
+#endif
+#if BRM_SCRATCH < 0x6000UL
+#error "the BRAM work area is inside the region the BIOS visit exchanges"
+#endif
+
+static UBYTE *const brm_work  = (UBYTE *)BRM_SCRATCH;          /* 0x640 */
+static UBYTE *const brm_names = (UBYTE *)(BRM_SCRATCH + 0x640);/* 12 */
+static struct brmcall *const brmc =
+                (struct brmcall *)(BRM_SCRATCH + 0x680);
+static UWORD brm_size, brm_stat, brm_free, brm_files;
+static UBYTE brm_checked, brm_usable;
+
+/* Is the manager reachable, and are our buffers somewhere it can see?
+ *
+ * The visit exchanges 0..0x6000, so anything the BIOS is handed a
+ * pointer to has to live above that line. EmuTOS's .bss begins at
+ * 0x2140 and its stack is at 0x800, so this is a real question and not
+ * a formality -- the printer's page buffer landed at 0x2140 for exactly
+ * this reason and streamed a page of nothing.
+ *
+ * The addresses are fixed and checked at compile time above, so what
+ * is left to ask here is only whether there is any firmware parked to
+ * visit -- on a Mode 1 boot there is not. */
+static BOOL segacd_buram_ready(void)
+{
+    return bios_parked();
+}
+
+/* BRMINIT, then BRMSTAT. Reads nothing and writes nothing: this asks
+ * the manager what it can see, which is the whole of stage one. */
+static void segacd_buram_probe(void)
+{
+    brm_checked = 1;
+    brm_usable = 0;
+    brm_size = brm_stat = brm_free = brm_files = 0;
+
+    if (!segacd_buram_ready()) {
+        brm_stat = 0xFFFF;              /* could not even ask */
+        return;
+    }
+
+    brmc->fn = BRM_INIT;
+    brmc->d1in = 0;
+    brmc->a0in = (ULONG)brm_work;
+    brmc->a1in = (ULONG)brm_names;
+    segacd_buram_call(brmc);
+    brm_size = brmc->d0out;
+    /* Carry clear is "Sega formatted"; the status word only means
+     * anything when it is set. megadev's wrapper folds that into a
+     * fourth value and so does this. */
+    brm_stat = brmc->cs ? brmc->d1out : BRM_ST_SEGA;
+    if (brmc->cs)
+        return;
+
+    brmc->fn = BRM_STAT;
+    brmc->d1in = 0;
+    brmc->a0in = 0;
+    brmc->a1in = (ULONG)brm_names;
+    segacd_buram_call(brmc);
+    brm_free = brmc->d0out;
+    brm_files = brmc->d1out;
+    brm_usable = 1;
+}
+
+/* Packed for SCD_BRAM_INFO. Probed on demand rather than at boot: two
+ * visits to the parked firmware cost about six milliseconds, and until
+ * something asks there is nothing to spend them on. */
+static ULONG segacd_buram_info(BOOL again)
+{
+    ULONG st, sz, fr, nf;
+
+    if (!brm_checked || again)
+        segacd_buram_probe();
+
+    st = (brm_stat == 0xFFFF) ? 0xFFUL : (ULONG)brm_stat;
+    sz = (brm_size  > 0xFF)   ? 0xFFUL : (ULONG)brm_size;
+    fr = (brm_free  > 0xFF)   ? 0xFFUL : (ULONG)brm_free;
+    nf = (brm_files > 0xFF)   ? 0xFFUL : (ULONG)brm_files;
+    return (st << 24) | (sz << 16) | (fr << 8) | nf;
+}
+
 static void bram_probe(void)
 {
     UBYTE save;
diff --git a/bios/segacd.h b/bios/segacd.h
index 6868483..3328e54 100644
--- a/bios/segacd.h
+++ b/bios/segacd.h
@@ -114,6 +114,45 @@ void segacd_cdd_put(const UBYTE *src);  /* ten command bytes, BIOS form */
 void segacd_cdc_read(UWORD *hdr, UWORD *data, LONG groups);
 void segacd_call_5ms(void);
 
+/* Sega's own Backup RAM manager, through the parked firmware.
+ *
+ * Layout is shared with segacd2.S by offset, so the two must be changed
+ * together. Everything reachable from here by pointer -- this block, the
+ * work area, the string buffer, any data -- has to sit outside the 24 KB
+ * the visit exchanges, which rules out both the stack (0x800) and the
+ * start of .bss (0x2140). segacd_buram_ready() is where that is checked
+ * rather than assumed. */
+struct brmcall {
+    UWORD fn;                   /* BRM_* below */
+    UWORD d0out;
+    UWORD d1out;
+    UWORD cs;                   /* nonzero: the BIOS reported failure */
+    ULONG d1in;
+    ULONG a0in;
+    ULONG a1in;
+    ULONG a0out;
+};
+void segacd_buram_call(struct brmcall *c);      /* segacd2.S */
+
+/* Function codes for _BURAM (0x5F16). megadev lib/sub/bram.def.h, MIT. */
+#define BRM_INIT    0x0000
+#define BRM_STAT    0x0001
+#define BRM_SERCH   0x0002
+#define BRM_READ    0x0003
+#define BRM_WRITE   0x0004
+#define BRM_DEL     0x0005
+#define BRM_FORMAT  0x0006
+#define BRM_DIR     0x0007
+#define BRM_VERIFY  0x0008
+
+/* BRMINIT's status in d1 when it fails: 0 no RAM, 1 unformatted, 2 some
+ * other format. Success is carry clear, and then d0 is the size in
+ * blocks of 0x1000 bytes -- 2 for the internal 8 KB, up to 0x100. */
+#define BRM_ST_NONE     0
+#define BRM_ST_UNFORMAT 1
+#define BRM_ST_OTHER    2
+#define BRM_ST_SEGA     3       /* ours, for the carry-clear case */
+
 #endif /* MACHINE_SEGACD */
 
 #endif /* SEGACD_H */
diff --git a/bios/segacd2.S b/bios/segacd2.S
index 66402d4..cf34d98 100644
--- a/bios/segacd2.S
+++ b/bios/segacd2.S
@@ -200,6 +200,65 @@ _segacd_bios_call:
         movem.l (sp)+,d1-d7/a0-a6
         rts
 
+// void segacd_buram_call(struct brmcall *c)
+//
+// The same visit, to the other door. 0x5F22 is the CDBIOS dispatch that
+// segacd_bios_call above uses; 0x5F16, three words below it, is _BURAM,
+// which is the machine's own Backup RAM file manager -- BRMINIT,
+// BRMSTAT, BRMSERCH, BRMREAD, BRMWRITE, BRMDEL, BRMFORMAT, BRMDIR,
+// BRMVERIFY. (Vector and function codes: megadev lib/sub/bram.def.h,
+// MIT.) Sega's format is then Sega's code's problem and never ours,
+// which is the entire reason for going through here rather than laying
+// our own volume over the top of it as this port has done until now.
+//
+// Everything the BIOS is handed a pointer to -- the call block, the
+// 0x640-byte work area, the string buffer, any data buffer -- MUST live
+// outside the 24 KB that gets exchanged, because during the call that
+// region is holding EmuTOS's bytes rather than its own. EmuTOS's .bss
+// starts at 0x2140, which is inside it, so a plain static is exactly
+// the wrong place and the C side checks the address rather than
+// assuming. Its stack is at 0x800 and is inside it too, so nothing may
+// be passed by reference off the stack either.
+//
+// The block, matching struct brmcall in segacd.h exactly:
+//   +0  w  fn        the function code, in
+//   +2  w  d0out     +4  w  d1out    +6  w  cs (nonzero = the call failed)
+//   +8  l  d1in      +12 l  a0in     +16 l  a1in     +20 l  a0out
+        .globl  _segacd_buram_call
+_segacd_buram_call:
+        move.l  4(sp),d0                // the call block
+        movem.l d1-d7/a0-a6,-(sp)
+        move.l  d0,a5                   // outside the swap; the BRM
+                                        // functions clobber only d0-d1
+                                        // and a0-a1
+        move.w  sr,-(sp)
+        ori.w   #0x0700,sr
+
+        move.l  sp,a6
+        move.l  #0xB9F00,sp             // the same scratch stack
+
+        bsr     bios_xchg
+        move.w  (a5),d0                 // fn
+        move.l  8(a5),d1                // d1 in
+        move.l  12(a5),a0               // a0 in
+        move.l  16(a5),a1               // a1 in
+        jsr     0x5F16                  // _BURAM
+        // Carry first: every one of these functions answers cc/cs, and
+        // d0 means something different in each. Taken before anything
+        // else can disturb it.
+        moveq   #0,d2
+        scs     d2
+        move.w  d0,2(a5)
+        move.w  d1,4(a5)
+        move.w  d2,6(a5)
+        move.l  a0,20(a5)
+        bsr     bios_xchg
+
+        move.l  a6,sp
+        move.w  (sp)+,sr
+        movem.l (sp)+,d1-d7/a0-a6
+        rts
+
 // Exchange low memory with the park. Uses only registers and the
 // scratch stack; touches nothing in the region it is moving.
 bios_xchg:
