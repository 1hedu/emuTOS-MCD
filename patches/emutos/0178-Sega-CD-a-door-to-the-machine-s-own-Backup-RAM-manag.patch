 #define SCD_PRINT_PAGE    18
+/* Ask Sega's own Backup RAM manager what it sees, through the parked
+ * firmware -- BRMINIT then BRMSTAT, reading nothing and writing nothing.
+ * Packed into one long because that is what control() returns:
+ *
+ *   bits 31-24  status  0 no RAM, 1 unformatted, 2 another format,
+ *                       3 Sega formatted, 0xFF could not ask at all
+ *                       (no firmware parked, or our buffers landed
+ *                       inside the region the visit exchanges)
+ *   bits 23-16  size, in blocks of 0x1000 -- 2 is the internal 8 KB
+ *   bits 15-8   free, in blocks of 0x40
+ *   bits 7-0    files in the directory
+ *
+ * The two block sizes are not a transcription error. BRMINIT reports
+ * the memory in 0x1000s (2 to 0x100, so 8 KB to 1 MB) and BRMSTAT
+ * reports free space in the 0x40 units the directory allocates in --
+ * megadev's header says 0x1000 for both, and the console disagrees:
+ * against the internal 8 KB it answered 125, which is 8192/64 - 3, the
+ * three being the blocks the volume footer occupies. Genesis Plus GX
+ * computes the same 125 the same way. Two sources, one number.
+ *
+ * Every field is a byte because every one of them fits: 0x100 blocks is
+ * the largest memory, and free space clamps. */
+#define SCD_BRAM_INFO     19
 #define SCD_CARTSWAP      11            /* Mode 1: expect the cartridge to
                                          * be pulled and another put in */
 
