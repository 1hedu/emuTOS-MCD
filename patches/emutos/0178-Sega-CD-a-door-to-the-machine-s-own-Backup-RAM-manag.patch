 bios/segacd.c  | 127 +++++++++++++++++++++++++++++++++++++++++++++++++
 bios/segacd.h  |  39 +++++++++++++++
 bios/segacd2.S |  59 +++++++++++++++++++++++
 4 files changed, 249 insertions(+), 1 deletion(-)

