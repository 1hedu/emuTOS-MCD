         WORD lshort;
+        UWORD ringok, dsr, edt, nz, boff, bnz, slotbad;
+        ULONG newest, blba, swant, sgot, sbase;
+        UBYTE shave, ssrc;
+        UBYTE bsrc;
+        UBYTE hdr[4], st4[4];
         UBYTE state, lasth3;
         int i;
 
@@ -1230,6 +1235,31 @@ void biosmain(void)
              * announced count then the ring is being starved by this
              * test alone, and h3 says what to widen it to. */
             DLOG(" mode %u  h3 %02X\r\n", badmode, lasth3);
+            segacd_cd_probe(&ringok, &newest, &dsr, &edt, &nz, hdr, st4,
+                            &blba, &boff, &bsrc, &bnz,
+                            &slotbad, &swant, &sgot,
+                            &sbase, &shave, &ssrc);
+            /* Has the ring ever taken an entry on this machine, and
+             * what is the newest sector in it. 4294967295 is empty. */
+            DLOG(" ring %u  new %ld\r\n", ringok, newest);
+            /* The two handshakes inside a transfer, and whether the
+             * sector had any bytes in it: 2048 means the wait gave up,
+             * and nz 0 out of 512 means nothing arrived. */
+            DLOG(" dsr %u edt %u  nz %u\r\n", dsr, edt, nz);
+            /* The header and decoder status of the last sector, raw. */
+            /* The last block handed to GEMDOS: which CD sector and
+             * offset it came from, whether it was a cache hit (0), the
+             * mount probe (1) or a refill (2), and how many of its 128
+             * longs were not zero. */
+            DLOG(" blk %ld+%u s%u nz %u\r\n", blba, boff, bsrc, bnz);
+            /* The invariant: the slot the hand-off indexed must hold
+             * the sector it was asked for. Nonzero here is data handed
+             * to GEMDOS that never came off the disc. */
+            DLOG(" slot %u  want %ld got %ld\r\n", slotbad, swant, sgot);
+            DLOG(" base %ld have %u src %u\r\n", sbase, shave, ssrc);
+            DLOG(" hdr %02X%02X%02X%02X st4 %02X%02X%02X%02X\r\n",
+                 hdr[0], hdr[1], hdr[2], hdr[3],
+                 st4[0], st4[1], st4[2], st4[3]);
             /* Phase one of the timeshare: is the machine's own CDBIOS
              * still up there in Word RAM, and does it execute when
              * exchanged back into low memory? CDBCHK is the smallest
diff --git a/bios/segacd.c b/bios/segacd.c
index 5ff3521..5fddb32 100644
--- a/bios/segacd.c
+++ b/bios/segacd.c
@@ -275,6 +275,33 @@ static UWORD cd_why;            /* nibble per attempt of the last
  * what the byte actually is. */
 static UWORD cd_badmode;        /* decoded, mode byte neither 1 nor 2 */
 static UBYTE cd_lasth3;         /* the last such byte, verbatim */
+/* Everything else a console cannot currently say out loud.
+ *
+ * Adding these one at a time costs a CD-R and an hour per question,
+ * so they go in together: whether the ring has EVER taken an entry
+ * here, how long the two transfer handshakes actually waited, and
+ * whether the sector that arrived had any bytes in it at all. Each
+ * one is a counter already implied by a branch that exists; none of
+ * them changes what the driver does. */
+static UWORD cd_ring_ok;        /* sectors that made it into the ring */
+static UWORD cd_dsr_n, cd_edt_n;/* iterations the last grab spent
+                                 * waiting for data-set-ready and for
+                                 * end-of-transfer; 2048 means it gave
+                                 * up rather than that it was slow */
+/* And the same question one layer up. cdc_grab now says the sector
+ * arrived with 512 nonzero longs in it while the Fread that asked for
+ * it came back as zeroes, so the loss is between the cache and
+ * GEMDOS, not on the disc side. These four say which block was asked
+ * for, where it was served from, and whether it had anything in it. */
+static ULONG cd_blk_lba;        /* CD sector the last block came from */
+static UWORD cd_blk_off;        /* and its offset within that sector */
+static UBYTE cd_blk_src;        /* 0 cache hit, 1 mount probe, 2 refill */
+static UWORD cd_blk_nz;         /* nonzero longs handed back, of 128 */
+static UWORD cd_xfer_nz;        /* nonzero longs of the last sector
+                                 * fetched, out of 512. Zero here with
+                                 * a passing header check is the round
+                                 * one Fread that reads as all zeroes
+                                 * while every other counter is clean */
 static UWORD cd_lastints = 0xFFFF;      /* decoder interrupts during the
                                  * attempt that gave up: zero is a deaf
                                  * drive, and 0xFFFF is no timeout yet --
@@ -1077,6 +1104,7 @@ void segacd_int_5_c(void)
             cd_ring_age[k] = cdc_ints;
             cd_ring_head = (UBYTE)((k + 1) % CD_RING);
             cd_ring_newest = lba;
+            cd_ring_ok++;
         }
     } else if (h3 == 0x01 || h3 == 0x02) {
         cd_badhdr++;            /* decoded, mode plausible, MSF impossible */
@@ -1136,6 +1164,7 @@ static BOOL cdc_grab(UWORD pt)
     for (n = 0; n < 2048; n++)                  /* CDCTRN's own bound */
         if (*CDC_MODE_RD & CDC_DSR)
             break;
+    cd_dsr_n = n;
 
     if (n < 2048) {
         segacd_cdc_read((UWORD *)cdc_hdr, (UWORD *)CDSECT,
@@ -1158,10 +1187,23 @@ static BOOL cdc_grab(UWORD pt)
                 break;
             cdc_spill = *CDC_HOST;
         }
+        cd_edt_n = n;
         if (n < 2048)
             ok = TRUE;
         else
             cdc_fail = 2;                       /* no end of transfer */
+
+        {   /* Did any bytes actually arrive? Counted as longs so the
+             * loop is 512 iterations and not 2048; this runs once per
+             * sector in the foreground, not in an interrupt. */
+            const ULONG *p = (const ULONG *)CDSECT;
+            UWORD i, nz = 0;
+
+            for (i = 0; i < CDC_DATA_BYTES / 4; i++)
+                if (p[i])
+                    nz++;
+            cd_xfer_nz = nz;
+        }
     } else {
         cdc_fail = 1;                           /* never became ready */
     }
@@ -2187,6 +2229,24 @@ static void cd_park(void)
 #define CD_CACHE_SECTORS 6
 
 static UBYTE cd_cache[CD_CACHE_SECTORS][CDC_DATA_BYTES];
+/* Which sector is actually in each slot, or 0xFFFFFFFF for nothing.
+ *
+ * cd_cache_base and cd_cache_have describe what the cache is supposed
+ * to hold, and the hand-off trusts them: it indexes a slot by
+ * subtraction and copies whatever is there. If those two ever
+ * disagree with reality the result is a block of zeroes -- or of the
+ * previous fill -- handed to GEMDOS as a success, which is exactly
+ * what a Dfree reporting 348 free clusters where the disc has 92 looks
+ * like. 256 clusters is one 512-byte block of FAT read as zeroes.
+ *
+ * So the slots say for themselves what they contain, and the hand-off
+ * checks rather than assumes. This is an invariant, not a heuristic:
+ * a mismatch cannot be a legitimately empty sector. */
+static ULONG cd_cache_slot[CD_CACHE_SECTORS];
+static UWORD cd_slotbad;        /* hand-offs where the slot disagreed */
+static ULONG cd_slot_want, cd_slot_got;         /* the first such pair */
+static ULONG cd_slot_base;      /* ...and what the cache claimed then */
+static UBYTE cd_slot_have, cd_slot_src;
 
 /* Fill the cache starting at lba: one seek, then as many more as the
  * drive hands over while we are still listening. */
@@ -2241,21 +2301,48 @@ static BOOL cd_fill_bios(ULONG lba)
     }
     cd_ts_reads++;
 
-    for (i = 0; i < want; i++)
+    for (i = 0; i < want; i++) {
         memcpy(cd_cache[i], scratch + (ULONG)i * CDC_DATA_BYTES,
                CDC_DATA_BYTES);
+        cd_cache_slot[i] = lba + i;
+    }
     cd_cache_base = lba;
     cd_cache_have = want;
     cd_cached = lba;
     return TRUE;
 }
 
+/* Fill the cache starting at lba, and publish what it holds only once
+ * it holds it.
+ *
+ * The read-ahead below calls cd_fetch, cd_fetch calls cdc_setup on its
+ * first attempt, and cdc_setup invalidates the cache -- correctly, it
+ * is re-initialising the decoder and moving the drive. This function
+ * used to set cd_cache_base before the read-ahead and then update only
+ * cd_cache_have inside it, so every successful read-ahead left the
+ * pair reading "six sectors starting at 0xFFFFFFFF".
+ *
+ * The hand-off indexes cd_cache by lba minus that base. 1614 minus
+ * 0xFFFFFFFF is 1615, so it read three megabytes past a six-element
+ * array and handed the result to GEMDOS as a sector. Usually that
+ * memory is zero, which is why Fread came back empty with every
+ * counter in the driver reporting perfect health, and why Dfree
+ * reported 348 free clusters on a disc that has 92 -- the difference
+ * is 256, which is exactly one 512-byte block of FAT read as zeroes.
+ *
+ * So nothing is published until the fill is over.
+ */
 static BOOL cd_fill(ULONG lba)
 {
-    UBYTE i;
+    UBYTE i, have;
 
     cd_cache_base = 0xFFFFFFFFUL;
     cd_cache_have = 0;
+    {
+        UBYTE k;
+        for (k = 0; k < CD_CACHE_SECTORS; k++)
+            cd_cache_slot[k] = 0xFFFFFFFFUL;
+    }
 
     if (cd_ts)
         return cd_fill_bios(lba);
@@ -2263,8 +2350,8 @@ static BOOL cd_fill(ULONG lba)
     if (!cd_fetch(lba))
         return FALSE;
     memcpy(cd_cache[0], CDSECT, CDC_DATA_BYTES);
-    cd_cache_base = lba;
-    cd_cache_have = 1;
+    cd_cache_slot[0] = lba;
+    have = 1;
 
     /* The rest are whatever the stream gives us without complaint. A
      * failure here is not an error -- we have what was asked for -- so
@@ -2279,9 +2366,14 @@ static BOOL cd_fill(ULONG lba)
         if (!cd_fetch(lba + i))
             break;
         memcpy(cd_cache[i], CDSECT, CDC_DATA_BYTES);
-        cd_cache_have = (UBYTE)(i + 1);
+        cd_cache_slot[i] = lba + i;
+        have = (UBYTE)(i + 1);
     }
 
+    /* Published here and nowhere earlier: see the note above. */
+    cd_cache_base = lba;
+    cd_cache_have = have;
+
     /* Ordinarily nothing follows the fill -- the drive is left running
      * and the next read names a new place, which is what the traced
      * CDBIOS does between its reads. But the trace also shows the drive
@@ -2299,6 +2391,58 @@ static BOOL cd_fill(ULONG lba)
 }
 
 /* One 512-byte block of D:, from the CD sector that contains it. */
+/* What the block layer just handed up, recorded at the one place it
+ * hands anything up. */
+static void cd_blk_note(ULONG lba, UWORD off, const UBYTE *buf)
+{
+    const ULONG *p = (const ULONG *)buf;
+    UWORD i, nz = 0;
+    ULONG idx = lba - cd_cache_base;
+
+    if (idx >= CD_CACHE_SECTORS || cd_cache_slot[idx] != lba) {
+        /* Reported, not merely counted: this is the shape of the bug
+         * above and there must never be a second one that only shows
+         * up as bad data three layers away. */
+        if (!cd_slotbad) {
+            cd_slot_want = lba;
+            cd_slot_got = (idx < CD_CACHE_SECTORS) ? cd_cache_slot[idx]
+                                                   : 0xFFFFFFFEUL;
+            cd_slot_base = cd_cache_base;
+            cd_slot_have = cd_cache_have;
+            cd_slot_src = cd_blk_src;
+        }
+        cd_slotbad++;
+    }
+
+    if (p)
+        for (i = 0; i < SECTOR_SIZE / 4; i++)
+            if (p[i])
+                nz++;
+    cd_blk_lba = lba;
+    cd_blk_off = off;
+    cd_blk_nz = nz;
+}
+
+/* The one place a cached sector becomes a GEMDOS block.
+ *
+ * It checks the slot rather than trusting the subtraction. An index
+ * that cannot be justified is a failed read, not a copy from wherever
+ * it points: the alternative, which this driver did until now, is
+ * three megabytes past the array and into GEMDOS's buffer as data. */
+static BOOL cd_hand_over(ULONG lba, UWORD off, UBYTE *buf)
+{
+    ULONG idx = lba - cd_cache_base;
+
+    if (idx >= CD_CACHE_SECTORS || cd_cache_slot[idx] != lba) {
+        cd_blk_note(lba, off, NULL);
+        return FALSE;
+    }
+    memcpy(buf, cd_cache[idx] + off, SECTOR_SIZE);
+    cd_blk_note(lba, off, buf);
+    cd_dtest |= 2;
+    return TRUE;
+}
+
 static BOOL cd_read_block(ULONG block, UBYTE *buf)
 {
     ULONG lba = CD_DDISK_LBA + (block >> CD_BPS_SHIFT);
@@ -2320,9 +2464,12 @@ static BOOL cd_read_block(ULONG block, UBYTE *buf)
         }
     }
 
+    cd_blk_src = 0;
     if (lba < cd_cache_base || lba >= cd_cache_base + cd_cache_have) {
         UBYTE go;
 
+        cd_blk_src = 2;
+
         /* The very first read is the mount probe, and it runs before
          * anything is on screen. It either works quickly -- the boot
          * environment is the quietest this machine ever is -- or the
@@ -2339,9 +2486,8 @@ static BOOL cd_read_block(ULONG block, UBYTE *buf)
             cd_leash = CD_XCHG_BUDGET;
             if (!go)
                 return FALSE;
-            memcpy(buf, cd_cache[lba - cd_cache_base] + off, SECTOR_SIZE);
-            cd_dtest |= 2;
-            return TRUE;
+            cd_blk_src = 1;
+            return cd_hand_over(lba, off, buf);
         }
 
         /* Twice, because the evidence says so: a fill that has just
@@ -2383,9 +2529,7 @@ static BOOL cd_read_block(ULONG block, UBYTE *buf)
             cd_leash = leash;
         }
     }
-    memcpy(buf, cd_cache[lba - cd_cache_base] + off, SECTOR_SIZE);
-    cd_dtest |= 2;
-    return TRUE;
+    return cd_hand_over(lba, off, buf);
 }
 
 /* The block-layer entry point. Read only: it is a compact disc. */
@@ -2713,6 +2857,38 @@ void segacd_cd_stats(UWORD *seeks, UWORD *hits, UWORD *errs,
     *flag = cd_flagged;
 }
 
+/* The rest of it, in a second call rather than eight more pointers on
+ * the first, which already takes eighteen. */
+void segacd_cd_probe(UWORD *ringok, ULONG *newest, UWORD *dsr, UWORD *edt,
+                     UWORD *nz, UBYTE *hdr, UBYTE *st4,
+                     ULONG *blba, UWORD *boff, UBYTE *bsrc, UWORD *bnz,
+                     UWORD *slotbad, ULONG *swant, ULONG *sgot,
+                     ULONG *sbase, UBYTE *shave, UBYTE *ssrc)
+{
+    int i;
+
+    *slotbad = cd_slotbad;
+    *sbase = cd_slot_base;
+    *shave = cd_slot_have;
+    *ssrc = cd_slot_src;
+    *swant = cd_slot_want;
+    *sgot = cd_slot_got;
+    *blba = cd_blk_lba;
+    *boff = cd_blk_off;
+    *bsrc = cd_blk_src;
+    *bnz = cd_blk_nz;
+
+    *ringok = cd_ring_ok;
+    *newest = cd_ring_newest;
+    *dsr = cd_dsr_n;
+    *edt = cd_edt_n;
+    *nz = cd_xfer_nz;
+    for (i = 0; i < 4; i++) {
+        hdr[i] = cdc_hdr[i];
+        st4[i] = cdc_stat4[i];
+    }
+}
