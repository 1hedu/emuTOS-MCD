From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: emuTOS-MCD <darekadumon@gmail.com>
Date: Tue, 11 Aug 2026 19:41:17 +0000
Subject: [PATCH 056/190] segacd: stop the drive, and start reading what it
 says

Two things this driver has been doing to real hardware that it should
never have done.

It never stopped the drive. cdc_stop() stops our decoder; the disc kept
turning and the head kept reading forward to the end of it, for as long
as the console was powered. There is a command for this -- 1, no
arguments, what the BIOS sends at $1A10 when it abandons an operation
-- and it costs one packet. Sent now when a read finishes and when the
sector self-test parks.

And it has never once looked at what the drive reports about itself.
$140E latches status nibble 0 into $5878 and dispatches sixteen ways on
it; the read path polls that byte and waits for state 8 before it
proceeds. We issue a read and watch for sectors. So when the drive is
saying it cannot, we talk over it and call the silence a timeout. The
byte is on the status row now, which is the first step to obeying it.
---
 bios/segacd.c | 40 +++++++++++++++++++++++++++++++++++++++-
 1 file changed, 39 insertions(+), 1 deletion(-)

diff --git a/bios/segacd.c b/bios/segacd.c
index a83b779..9a2b839 100644
--- a/bios/segacd.c
+++ b/bios/segacd.c
@@ -940,6 +940,26 @@ static void cdd_ask_read(const UBYTE *msf)
     cdd_handover = 1;           /* last: the interrupt reads this */
 }
 
+/* Command 1, no arguments: what the BIOS sends at $1A10 when it gives
+ * up on whatever it was doing.
+ *
+ * Nothing in this driver ever sent it, which means that after every
+ * read the drive carried on reading forward to the end of the disc and
+ * stayed there -- for as long as the console was on. That is hours of
+ * an optical head doing work nobody wanted. Sending it costs one
+ * packet. */
+static void cdd_ask_stop(void)
+{
+    int i;
+
+    for (i = 0; i < 9; i++)
+        cdd_next[i] = 0;
+    cdd_next[0] = 0x01;
+    cdd_want = 0xFF;
+    cdd_answered = 0;
+    cdd_handover = 1;
+}
+
 /* All nine nibbles zero. The drive is being asked for its status and
  * nothing else, which is what the BIOS sends between commands ($1A88)
  * and the safest packet there is -- and something has to be sent, since
@@ -1079,6 +1099,10 @@ static void cdr_report(void)
     CDREPORT[26] = cd_errors;
     CDREPORT[27] = cd_dtest;
     CDREPORT[28] = cd_why;
+    /* The drive's own state, nibble 0 of its status packet. The
+     * BIOS dispatches sixteen ways on this byte at $140E and this
+     * driver has never once looked at it. */
+    CDREPORT[29] = (UWORD)(((UWORD)cdd_stat[0] << 8) | cdd_stat[1]);
     CDREPORT[0] = CDREPORT_MAGIC;
 }
 
@@ -1210,6 +1234,7 @@ static void cdr_step(void)
                 cdr_slot++;
                 cdr_start(cdr_lbas[cdr_slot]);
             } else {
+                cdd_ask_stop();
                 cdr_state = CDR_PARKED;
             }
         }
@@ -1322,6 +1347,16 @@ collect:
     return got;
 }
 
+/* Let the drive rest. Called when a run of reads is over: without it
+ * the head keeps going to the end of the disc and sits there. */
+static void cd_park(void)
+{
+    if (cd_streaming) {
+        cd_streaming = 0;
+        cdd_ask_stop();
+    }
+}
+
 /* Sectors kept from one visit to the drive.
  *
  * A seek is most of a second; the sector after the one just read
@@ -1408,11 +1443,14 @@ LONG segacd_cd_rw(WORD rw, LONG sector, WORD count, UBYTE *buf)
         return ESECNF;
 
     while (count--) {
-        if (!cd_read_block((ULONG)sector, buf))
+        if (!cd_read_block((ULONG)sector, buf)) {
+            cd_park();
             return EREADF;
+        }
         sector++;
         buf += SECTOR_SIZE;
     }
+    cd_park();
     return E_OK;
 }
 
