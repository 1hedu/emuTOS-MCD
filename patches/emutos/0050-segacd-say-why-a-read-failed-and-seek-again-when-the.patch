+static UBYTE cdc_altctrl;       /* holding B picks the other CDC control pair;
+                                 * declared here because the init that reads
+                                 * the pad runs long before the CDC code */
 static UBYTE cdd_queued[9];
 static UBYTE cdd_next[9];       /* built by the VBL, taken by level 4 */
 static ULONG cdd_outbuf[3];     /* aligned: the write below is long-wide */
@@ -193,6 +196,16 @@ void segacd_cdd_init(void)
         } while ((f & 0xFF00) != 0x5A00 && --spin);
 
         cdd_cmd_on = (UBYTE)((f & 1) ? 0 : 1);
+
+        /* B does the same job for the decoder. The BIOS writes two
+         * different CTRL0/CTRL1 pairs -- $A0/$F8 when it resets the
+         * decoder and $A7/$F0 once the drive has locked -- and it waits
+         * on the drive's status in between, which this driver does not.
+         * Neither emulator models those registers meaningfully, so
+         * emulation cannot say whether the wait matters. Holding B
+         * selects the reset-time pair alone, so one disc can answer it
+         * instead of two. */
+        cdc_altctrl = (UBYTE)((f & 2) ? 1 : 0);
     }
 
     cdd_ask(CDD_CMD_INFO, 0x03);        /* something to say from the first
@@ -537,6 +550,10 @@ static UBYTE cdc_head[4];       /* header of the one it reported last */
 static UBYTE cdc_stat4[4];      /* STAT0-3 with it */
 static UBYTE cdc_want[3];       /* the header we are waiting for, BCD */
 static UWORD cdc_pt;            /* where in buffer RAM ours landed */
+static UWORD cdc_pt_last;       /* ...and where the newest one is, matched
+                                 * or not, so a read that never finds its
