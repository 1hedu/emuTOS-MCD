diff --git a/bios/segacd.c b/bios/segacd.c
index b59d834..7057df2 100644
--- a/bios/segacd.c
+++ b/bios/segacd.c
@@ -143,6 +143,13 @@ static UBYTE cdd_score;         /* valid packets in the last 16, latched */
 static UBYTE cdd_count, cdd_good;
 static UBYTE cdd_tick;
 static UBYTE cdd_cmd_on;        /* holding A at power-on turns these off */
+UBYTE segacd_diag;              /* holding Down runs the D: diagnostic */
+/* How far before the target a read is commanded. Sega uses two frames,
+ * measured three times in the hardware trace; this driver has always
+ * used twenty. Selectable at boot -- hold Left -- because with one
+ * CD-R left, choosing between them blind is not a decision I get to
+ * make on someone else's disc. */
+static ULONG cd_lead = 20UL;
 /* D: telemetry. Declared up here because the report that publishes it
  * is written before the code that keeps it, and a forward declaration
  * for four counters is less to get wrong than moving either. */
@@ -320,6 +327,18 @@ void segacd_cdd_init(void)
          * selects the reset-time pair alone, so one disc can answer it
          * instead of two. */
         cdc_altctrl = (UBYTE)((f & 2) ? 1 : 0);
+
+        /* Down: run the D: diagnostic instead of the desktop. With one
+         * CD-R left, "the folder will not open" has to become a return
+         * code and a counter without another burn.
+         *
+         * Left: command the read two frames before the target, which is
+         * what the CDBIOS does on this console -- measured, three times,
+         * in the trace. This driver asks for twenty. Twenty may be why
+         * the decoder never locks, or it may be load-bearing; the disc
+         * can now answer that instead of me choosing. */
+        segacd_diag = (UBYTE)((f & 4) ? 1 : 0);
+        cd_lead = (f & 8) ? 2UL : 20UL;
     }
 
     cdd_ask(CDD_CMD_INFO, 0x03);        /* something to say from the first
@@ -1058,7 +1077,7 @@ static void cdd_ask_idle(void)
  * frames late and the sector is behind the head, and reading forward
  * never comes back to it. Twenty frames is a quarter of a second of
  * run-up and costs nothing but that. */
-#define CDR_LEADIN 20UL
+#define CDR_LEADIN cd_lead
 
 /* ...and if it lands late anyway, ask again. This is the BIOS's own
  * answer: $4124 re-issues the whole read when an arriving header is not
@@ -1753,6 +1772,19 @@ LONG segacd_cd_rw(WORD rw, LONG sector, WORD count, UBYTE *buf)
     return E_OK;
 }
 
+/* What the D: layer has been through, for the on-screen diagnostic.
+ * The counters are the diagnosis: a read that fails and a read that
+ * never happened look identical from GEMDOS's side of the call. */
+void segacd_cd_stats(UWORD *seeks, UWORD *hits, UWORD *errs,
+                     UBYTE *state, UWORD *why)
+{
+    *seeks = cd_seeks;
+    *hits = cd_hits;
+    *errs = cd_errors;
+    *state = cdd_stat[0];
+    *why = cd_why;
+}
+
 LONG segacd_cd_ioctl(WORD op, void *arg)
 {
     ULONG *info = (ULONG *)arg;
diff --git a/bios/segacd.h b/bios/segacd.h
index 3c72012..4ce6180 100644
--- a/bios/segacd.h
+++ b/bios/segacd.h
@@ -34,6 +34,9 @@ void segacd_keyclick(void);
 /* D: -- a filesystem read off the disc itself, through the CDC */
 LONG segacd_cd_rw(WORD rw, LONG sector, WORD count, UBYTE *buf);
 LONG segacd_cd_ioctl(WORD op, void *arg);
+void segacd_cd_stats(UWORD *seeks, UWORD *hits, UWORD *errs,
+                     UBYTE *state, UWORD *why);
+extern UBYTE segacd_diag;       /* Down held at power-on */
 
 /* Clock */
 ULONG segacd_getdt(void);
