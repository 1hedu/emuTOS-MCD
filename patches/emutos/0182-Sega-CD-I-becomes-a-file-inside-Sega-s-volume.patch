+/* ---- I: as a file inside Sega's volume -------------------------------
+ *
+ * The old arrangement wrote our FAT12 over the whole memory, footer and
+ * all, so a cartridge could carry our files or a game's saves and not
+ * both. This is the other way round: Sega's volume stays Sega's, and our
+ * filesystem is one file in it called AROSDISK, sitting in the console's
+ * own Backup RAM Manager beside whatever else is there.
+ *
+ * Sector i of the volume is bytes [i*512, i*512+512) of that file. The
+ * manager hands back the file's address and the data is the odd byte of
+ * each word from one past it -- a0out + 1 + 2*i -- which is measured, not
+ * assumed; see docs/bram-filesystem.md. Reads and writes both go straight
+ * through that pointer, because a file's data takes a write in place and
+ * the manager reads back what we put there.
+ */
+#define BFS_NAME    "AROSDISK"          /* 11 chars, zero padded */
+
+static UBYTE *bfs_base;                 /* the file's data, or NULL */
+static UBYTE  bfs_tried;                /* asked the manager once already */
+static UWORD  bfs_sects;                /* 512-byte sectors in it */
+
+static UBYTE bfs_rd(ULONG i)
+{
+    return bfs_base[1 + 2 * i];
+}
+
+/* Write, then confirm, for the same reason bram_wr does: this is slow
+ * SRAM behind a gate array and a tight run of writes can be dropped on
+ * real hardware, which reads as a volume that mounts and loses files. */
+static void bfs_wr(ULONG i, UBYTE v)
+{
+    volatile UBYTE *p = bfs_base + 1 + 2 * i;
+    WORD tries;
+
+    for (tries = 0; tries < 8; tries++) {
+        *p = v;
+        if (*p == v)
+            return;
+    }
+}
+
+static void bfs_setname(void)
+{
+    const char *t = BFS_NAME;
+    WORD i;
+
+    for (i = 0; i < 11; i++)
+        bfs_nm[i] = (UBYTE)(*t ? *t++ : 0);
+    bfs_nm[11] = 0;
+}
+
+/* BRMINIT, which every other call needs in place first. FALSE means
+ * this is not a Sega volume and none of the rest applies. */
+static BOOL bfs_init(void)
+{
+    if (!segacd_buram_ready())
+        return FALSE;
+    brmc->fn = BRM_INIT;
+    brmc->d1in = 0;
+    brmc->a0in = (ULONG)brm_work;
+    brmc->a1in = (ULONG)brm_names;
+    segacd_buram_call(brmc);
+    return brmc->cs ? FALSE : TRUE;
+}
+
+/* Find AROSDISK. Sets bfs_base and bfs_sects, or clears them. */
+static BOOL bfs_find(void)
+{
+    bfs_base = NULL;
+    bfs_sects = 0;
+
+    if (!bfs_init())
+        return FALSE;
+    bfs_setname();
+    brmc->fn = BRM_SERCH;
+    brmc->d1in = 0;
+    brmc->a0in = (ULONG)bfs_nm;
+    brmc->a1in = 0;
+    segacd_buram_call(brmc);
+    if (brmc->cs)
+        return FALSE;                   /* no file of ours in there yet */
+    bfs_base = (UBYTE *)brmc->a0out;
+    bfs_sects = (UWORD)(brmc->d0out / (SECTOR_SIZE / 64));
+    if (!bfs_sects) {
+        bfs_base = NULL;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* Make one, as large as the volume will presently give us.
+ *
+ * BRMWRITE copies size*64 bytes from a1, and there is nowhere in this
+ * port to put a buffer that large -- 7680 bytes for the internal memory
+ * alone, on a machine whose spare fixed-address scratch is measured in
+ * hundreds. It does not need one. The call is being used to *allocate*,
+ * and every byte it copies is overwritten immediately afterwards through
+ * the pointer BRMSERCH returns, because a file's data takes a write in
+ * place. So a1 points at EmuTOS's own code at 0x80000: readable, on the
+ * right side of the exchange, and never written to. Any bytes would do;
+ * these are the ones that are certainly there.
+ */
+static BOOL bfs_create(void)
+{
+    UWORD have, want;
+    WORD i;
+
+    if (!bfs_init())
+        return FALSE;
+
+    brmc->fn = BRM_STAT;
+    brmc->d1in = 0;
+    brmc->a0in = 0;
+    brmc->a1in = (ULONG)brm_names;
+    segacd_buram_call(brmc);
+    have = brmc->d0out;                 /* free space, in 0x40 blocks */
+
+    /* Three blocks back for the directory to grow into, and a whole
+     * number of sectors so the block layer never sees a short one. */
+    if (have < 3 + (SECTOR_SIZE / 64))
+        return FALSE;
+    want = (UWORD)((have - 3) & ~((SECTOR_SIZE / 64) - 1));
+    if (!want)
+        return FALSE;
+
+    bfs_setname();
+    for (i = 0; i < 11; i++)
+        bfs_info[i] = bfs_nm[i];
+    bfs_info[11] = 0;                   /* normal mode: 0x40 to a block */
+    bfs_info[12] = (UBYTE)(want >> 8);
+    bfs_info[13] = (UBYTE)want;
+
+    brmc->fn = BRM_WRITE;
+    brmc->d1in = 0;                     /* Tech Bulletin #1 says so */
+    brmc->a0in = (ULONG)bfs_info;
+    brmc->a1in = 0x80000UL;             /* allocate; see above */
+    segacd_buram_call(brmc);
+    if (brmc->cs)
+        return FALSE;
+
+    return bfs_find();
+}
+
+/* One volume, two possible homes. Everything below writes through these
+ * rather than knowing which. */
+static UBYTE bvol_rd(ULONG i)
+{
+    return (bram_state == BRAM_SEGA) ? bfs_rd(i) : bram_rd(i);
+}
+static void bvol_wr(ULONG i, UBYTE v)
+{
+    if (bram_state == BRAM_SEGA) bfs_wr(i, v); else bram_wr(i, v);
+}
+static UWORD bvol_sectors(void)
+{
+    return (bram_state == BRAM_SEGA) ? bfs_sects : (UWORD)BRAM_SECTORS;
+}
+
+/* Lay down a minimal FAT12 volume in whichever home we have: one
+ * reserved sector, two 1-sector FATs, two root sectors, the rest data.
+ *
+ * Written through bvol_wr, so this is the same code whether the volume
+ * is the whole of the memory (the old arrangement, and any cartridge
+ * already carrying one) or a file inside Sega's (the new one). */
+static void bram_format(void)
+{
+    ULONG i;
+    UWORD sects = bvol_sectors();
+
+    if (sects < 6)                      /* boot + 2 FATs + 2 root + data */
+        return;
+
+    for (i = 0; i < SECTOR_SIZE * 5UL; i++)
+        bvol_wr(i, 0);
+
+    bvol_wr(0, 0x60); bvol_wr(1, 0x38);            /* bra.s, Atari style */
+    bvol_wr(2, 'E'); bvol_wr(3, 'm'); bvol_wr(4, 'u');
+    bvol_wr(5, 'T'); bvol_wr(6, 'O'); bvol_wr(7, 'S');
+    bvol_wr(8, 0x24); bvol_wr(9, 0x08); bvol_wr(10, 0x27);
+    bvol_wr(11, 0x00); bvol_wr(12, 0x02);          /* 512 bytes/sector */
+    bvol_wr(13, 1);                                /* sectors/cluster */
+    bvol_wr(14, 1); bvol_wr(15, 0);                /* reserved sectors */
+    bvol_wr(16, 2);                                /* FAT count */
+    bvol_wr(17, 32); bvol_wr(18, 0);               /* root entries */
+    bvol_wr(19, (UBYTE)sects); bvol_wr(20, (UBYTE)(sects >> 8));
+    bvol_wr(21, 0xF8);                             /* media descriptor */
+    bvol_wr(22, 1); bvol_wr(23, 0);                /* sectors per FAT */
+    bvol_wr(24, 16); bvol_wr(25, 0);               /* sectors per track */
+    bvol_wr(26, 1); bvol_wr(27, 0);                /* sides */
+    /* The signature the block layer looks for. A volume with no
+     * partition table reaches check_for_no_partitions() in disk.c only
+     * when the root sector ends 55 AA, and this formatter left those two
+     * bytes zero -- so I: never mounted, however well the memory worked.
+     * D: and S: got away with it because internal_inquire() calls the
+     * disc and the cartridge removable and disk_init_one() force-adds a
+     * partition for a removable unit. The internal backup RAM is
+     * soldered down, so nothing covered for it. */
+    bvol_wr(510, 0x55); bvol_wr(511, 0xAA);
+
+    bvol_wr(512, 0xF8); bvol_wr(513, 0xFF); bvol_wr(514, 0xFF);
+    bvol_wr(1024, 0xF8); bvol_wr(1025, 0xFF); bvol_wr(1026, 0xFF);
+
+    {   /* volume label in the first root entry */
+        static const char lbl[11] = {'M','E','G','A','C','D',' ',
+                                     ' ',' ',' ',' '};
+        for (i = 0; i < 11; i++)
+            bvol_wr(1536 + i, (UBYTE)lbl[i]);
+        bvol_wr(1536 + 11, 0x08);
+    }
+}
+
+/* Make the file first if there is none, then lay the volume in it. This
+ * is what FORMATI.PRG reaches, and what holding C at power-on runs. */
+static void bram_make(void)
+{
+    if (bram_state == BRAM_SEGA || bfs_find() || bfs_create()) {
+        if (!bfs_base)
+            return;
+        bram_state = BRAM_SEGA;
+    }
+    bram_format();
+}
+
