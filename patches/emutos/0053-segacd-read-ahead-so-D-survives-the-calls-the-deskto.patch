+     *
+     * The count is worked out rather than picked, because picking it is
+     * what went wrong: "a couple of seconds" was six million, and six
+     * million is nearly half a minute. The loop is an increment, a
+     * compare, a branch, a byte test on an absolute address and another
+     * branch -- call it sixty cycles at 12.5 MHz, so about five
+     * microseconds an iteration. Three seconds is six hundred thousand,
+     * and three seconds is a slow seek plus a spin-up.
+     *
+     * Eight seconds, not three. The first read after the drive has sat
+     * idle has to wake it, and three was not enough -- Dfree failed,
+     * and a desktop window that calls Dfree before it opens simply did
+     * not open. What made boot feel dead was never this number: it was
+     * three deliberate probe seeks before anything reached the screen,
+     * and those are gone. A read that succeeds still costs only as long
+     * as it takes. */
+    for (spin = 0; spin < 1600000UL; spin++) {
         if (cdc_hit)
             return TRUE;
+        if (cdc_ints) {
+            /* Sectors are arriving, so the drive has done as it was
+             * told. Stop telling it.
+             *
+             * This is the same mistake twice, and the second time it
+             * cost a mounted drive that would not open. A queued
+             * command goes out on every exchange -- seventy-five times
+             * a second -- so leaving "start reading at this position"
+             * in the queue while waiting for a sector twenty frames
+             * further on means the drive is asked to start over before
+             * it ever gets there. It never arrives, the read times out,
+             * and GEMDOS turns that into a Dfree failure and a desktop
+             * window that silently does nothing.
+             *
+             * Stage 3's state machine has always done this correctly:
+             * it leaves the command state the moment the decoder
+             * reports anything. This is that, in a spin loop. */
+            if (!cd_quiet) {
+                cd_quiet = 1;
+                cdd_ask_idle();
+            }
+            /* And if the head is already beyond the sector we want,
+             * waiting cannot help: the drive reads forward and is not
+             * coming back. Say so now rather than spend the timeout
+             * learning it. */
+            if (cdr_past_target())
+                return FALSE;
+        }
+        /* The drive interrupt's storm guard counts arrivals between
+         * VBLs and switches level 4 off past a thousand. Its premise is
+         * that the VBL keeps running; here we are deliberately blocking
+         * in foreground and it does not. Without this the guard trips
+         * after thirteen seconds of honest waiting and takes the drive
+         * down with it. */
+        cdd_burst = 0;
     }
     return FALSE;
 }
@@ -1187,17 +1255,55 @@ static BOOL cd_fetch(ULONG lba)
 {
     UBYTE start[3];
     int attempt;
+    BOOL got = FALSE;
+    /* Read-ahead asks for the sector immediately behind the head and
+     * must never seek for it: the whole point is that it is nearly
+     * free. One attempt, and if the stream has moved on, so have we. */
+    int tries = (cd_streaming && lba == cd_next) ? 1 : 3;
+
+    /* Take the drive. The VBL rotates a status question at the CDD
+     * every thirty-two frames, and a question is a command like any
+     * other: queued while a read is in flight it replaces the read, or
+     * interrupts the streaming that read is waiting on. Stage 3's state
