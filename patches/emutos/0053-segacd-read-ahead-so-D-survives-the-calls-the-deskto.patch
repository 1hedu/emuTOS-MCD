+        int i;
+
+        cprintf("\033E");
+        cprintf("C: read test\r\n");
+
+        rc = Dfree((LONG *)buf, 1);             /* control: A: */
+        cprintf("DfreeA   = %ld free %ld of %ld\r\n",
