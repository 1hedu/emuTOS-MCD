@@ -1169,14 +1188,63 @@ static BOOL cd_wait_hit(void)
 {
     ULONG spin;
 
-    /* Bounded by a count rather than by the 200 Hz tick, because a
-     * mount can happen before that tick exists. Long enough for a seek
-     * and a spin-up -- a couple of seconds -- and irrelevant to the
-     * common case, where the sector is already on its way and arrives
-     * within thirteen milliseconds. */
-    for (spin = 0; spin < 6000000UL; spin++) {
+    /* Bounded by a count rather than by the 200 Hz tick, because the
+     * first read happens during BIOS init and that tick may not exist
