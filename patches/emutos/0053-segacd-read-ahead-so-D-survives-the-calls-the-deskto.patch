- * exercises the sector cache, the four-blocks-per-sector arithmetic and
- * the seek-versus-wait decision, none of which block 0 alone touches.
- *
- * What it checks is what the builder guarantees: block 0 is a FAT16
- * boot sector with our OEM name and the 0x55AA signature, and the
- * blocks past the end of the FAT are the zeroes mkfat.py left there.
- * Weak evidence on its own; strong beside a pattern sector that already
- * matched byte for byte. */
-static void cd_selftest(void)
-{
-    static UBYTE buf[SECTOR_SIZE];
-    ULONG probe[3];
-    UBYTE ok = 1;
-    int i;
-
-    probe[0] = 0;
-    probe[1] = CD_DDISK_BLOCKS / 2;
-    probe[2] = CD_DDISK_BLOCKS - 1;
-
-    cd_dtest = 1;
-    for (i = 0; i < 3; i++) {
-        if (!cd_read_block(probe[i], buf)) {
-            ok = 0;
-            break;
-        }
-        if (i == 0) {
-            /* the boot sector the disc builder wrote */
-            if (buf[510] != 0x55 || buf[511] != 0xAA
-                    || buf[2] != 'E' || buf[3] != 'm' || buf[4] != 'u')
-                ok = 0;
-        } else {
-            UWORD k;
-            for (k = 0; k < SECTOR_SIZE; k++)
-                if (buf[k])
-                    ok = 0;
-        }
-    }
-    if (ok)
-        cd_dtest |= 2;
-}
