@@ -993,6 +1011,7 @@ static void cdr_report(void)
     CDREPORT[25] = cd_hits;
     CDREPORT[26] = cd_errors;
     CDREPORT[27] = cd_dtest;
+    CDREPORT[28] = cd_why;
