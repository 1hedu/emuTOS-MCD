+
+/* Sectors kept from one visit to the drive.
+ *
+ * A seek is most of a second; the sector after the one just read
+ * arrives thirteen milliseconds later, free, because the drive is
+ * already reading forward. So take several while we are there.
+ *
+ * Without this, D: worked for small reads and fell over on the one
+ * operation that matters most: Dfree walks the whole file allocation
+ * table -- eight CD sectors -- and the desktop calls Dfree before it
+ * opens a window. Each of those eight cost a seek, because between one
+ * GEMDOS block and the next the head moves on and the stream is lost.
+ * Eight seeks is eight seconds when it works, and eight chances to
+ * fail when it does not: the window stayed shut. */
+#define CD_CACHE_SECTORS 8
+
+static UBYTE cd_cache[CD_CACHE_SECTORS][CDC_DATA_BYTES];
+
+/* Fill the cache starting at lba: one seek, then as many more as the
+ * drive hands over while we are still listening. */
+static BOOL cd_fill(ULONG lba)
+{
+    UBYTE i;
+
+    cd_cache_base = 0xFFFFFFFFUL;
+    cd_cache_have = 0;
+
+    if (!cd_fetch(lba))
+        return FALSE;
+    memcpy(cd_cache[0], CDSECT, CDC_DATA_BYTES);
+    cd_cache_base = lba;
+    cd_cache_have = 1;
+
+    /* The rest are whatever the stream gives us without complaint. A
+     * failure here is not an error -- we have what was asked for -- so
+     * it stops the read-ahead and nothing else. */
+    for (i = 1; i < CD_CACHE_SECTORS; i++) {
+        if (lba + i >= CD_DDISK_LBA + (CD_DDISK_BLOCKS >> CD_BPS_SHIFT))
+            break;
+        if (!cd_fetch(lba + i))
+            break;
+        memcpy(cd_cache[i], CDSECT, CDC_DATA_BYTES);
+        cd_cache_have = (UBYTE)(i + 1);
+    }
+    return TRUE;
 }
 
 /* One 512-byte block of D:, from the CD sector that contains it. */
@@ -1235,9 +1390,23 @@ static BOOL cd_read_block(ULONG block, UBYTE *buf)
     ULONG lba = CD_DDISK_LBA + (block >> CD_BPS_SHIFT);
     UWORD off = (UWORD)((block & ((1U << CD_BPS_SHIFT) - 1)) * SECTOR_SIZE);
 
-    if (cd_cached != lba && !cd_fetch(lba))
-        return FALSE;
-    memcpy(buf, CDSECT + off, SECTOR_SIZE);
+    cd_dtest |= 1;
+    if (lba < cd_cache_base || lba >= cd_cache_base + cd_cache_have) {
+        /* Twice, because the evidence says so: a fill that has just
+         * failed three times over succeeds immediately when started
+         * again from scratch. The first read after the drive has been
+         * doing something else is the one that fails, and only that
+         * one -- the desktop's very first act on a drive is Dfree, so
+         * the cost of not retrying here is a window that never opens.
+         *
+         * Why a fresh fill works where the retries inside one did not
+         * is not yet understood. Written down as a mitigation, not as
+         * a fix, so that it is not mistaken for one later. */
+        if (!cd_fill(lba) && !cd_fill(lba))
+            return FALSE;
+    }
+    memcpy(buf, cd_cache[lba - cd_cache_base] + off, SECTOR_SIZE);
+    cd_dtest |= 2;
     return TRUE;
 }
 
@@ -1258,52 +1427,6 @@ LONG segacd_cd_rw(WORD rw, LONG sector, WORD count, UBYTE *buf)
     return E_OK;
