     lba_to_msf(lba, cdc_want);
 
-    for (attempt = 0; attempt < 3; attempt++) {
-        if (!cd_streaming || lba < cd_next || lba > cd_next + CD_STREAM_AHEAD) {
-            /* Out of reach of the stream: seek. */
+    /* Three goes, and the third is not the same as the second.
+     *
+     * Waiting for a sector the drive is about to deliver is the fast
+     * path and it misses often: between one GEMDOS block and the next
+     * the head keeps moving, so by the time we are looking, the sector
+     * we wanted has gone past. That costs a seek, which is fine.
+     *
+     * What is not fine is a seek that also lands past the target, which
+     * is why the last attempt asks the drive to start much further
+     * back. Reading forward over sixty extra sectors costs most of a
+     * second; failing costs a read error, and GEMDOS turns a read error
+     * on Dfree into a desktop window that silently does not open. */
+    static const ULONG leadin[3] = { CDR_LEADIN, CDR_LEADIN, CDR_LEADIN * 3 };
+
+    for (attempt = 0; attempt < tries; attempt++) {
+        if (attempt > 0 || !cd_streaming
+                || lba < cd_next || lba > cd_next + CD_STREAM_AHEAD) {
+            ULONG back = leadin[attempt];
+
             cdc_hit = 0;
             cdc_ints = 0;
-            cdc_setup();
-            lba_to_msf(lba >= CDR_LEADIN ? lba - CDR_LEADIN : 0, start);
+            /* Only the first attempt resets the decoder. Doing it on
+             * every retry tears down whatever lock the last one had
+             * just achieved, which turns three tries into three cold
+             * starts -- and the first read after the drive has been
+             * doing something else is exactly the one that needs the
+             * lock to survive. */
+            if (attempt == 0)
+                cdc_setup();
+            lba_to_msf(lba >= back ? lba - back : 0, start);
             cdd_ask_read(start);
+            cd_quiet = 0;
             cd_streaming = 1;
             cd_seeks++;
         } else {
@@ -1205,18 +1311,18 @@ static BOOL cd_fetch(ULONG lba)
             cd_hits++;
         }
 
+        cd_why = (UWORD)((cd_why << 4)
+                       | ((cdc_ints && cdr_past_target()) ? 2 : 1));
         if (cd_wait_hit()) {
-            /* The drive is reading. Stop telling it to start, or the
-             * same "begin at this position" command goes out seventy-five
-             * times a second for as long as D: is mounted -- which is
-             * the stage 2 lesson upside down: the conversation needs a
-             * turn every exchange, but it needs the *right* turn, and
-             * repeating a seek for ever is not it. */
-            cdd_ask_idle();
+            /* The command was withdrawn inside the wait, as soon as the
+             * decoder reported anything -- see cd_wait_hit(). */
+            cd_why = (UWORD)((cd_why & ~0x0F) | 3);
             if (cdc_grab()) {
+                cd_why >>= 4;           /* it worked; forget this attempt */
                 cd_cached = lba;
                 cd_next = lba + 1;
-                return TRUE;
+                got = TRUE;
+                break;
             }
         }
 
@@ -1224,9 +1330,58 @@ static BOOL cd_fetch(ULONG lba)
         cd_streaming = 0;
     }
 
-    cd_errors++;
-    cd_cached = 0xFFFFFFFFUL;
-    return FALSE;
+    if (!got) {
+        cd_errors++;
+        cd_cached = 0xFFFFFFFFUL;
+    }
+    cd_busy = 0;
+    return got;
