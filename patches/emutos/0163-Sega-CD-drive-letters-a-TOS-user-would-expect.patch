     }
+#endif
+    *(volatile UWORD *)0xFF802E = 0xEE03;       /* device is not 0 or 1 */
+    return EUNDEV;
+}
+
+/******************************************************************************/
+/* C: -- the ramdisk, and D: -- the console's own backup RAM                  */
+/******************************************************************************/
+
+/* The two stores that cannot be taken out of the machine, so the two
+ * that get letters from C: on. Block devices rather than floppies for
+ * exactly that reason: what is on A: and B: is what a person can remove
+ * and replace, and neither of these can be.
+ *
+ * The ramdisk is listed first in disk.c's majors[], so it is C: -- the
+ * drive EmuTOS makes current, scans for AUTO, and reads EMUDESK.INF and
+ * EMUICON.RSC from. That is what C: means on a TOS machine and it is
+ * true here without an override: the system disk is in cartridge ROM,
+ * always present, and nothing the user does can change it. */
+
+LONG segacd_ramdisk_rw(WORD rw, LONG sector, WORD count, UBYTE *buf)
+{
+    UBYTE *p;
 
-    if (dev != 1) {
-        *(volatile UWORD *)0xFF802E = 0xEE03;   /* device is not 0 or 1 */
+    if (!adisk_present)
         return EUNDEV;
+    if (sector < 0 || sector + count > ADISK_SECTORS)
+        return ESECNF;
+
+    p = ADISK_BASE + sector * SECTOR_SIZE;
+    if (rw & RW_WRITE)
+        memcpy(p, buf, (LONG)count * SECTOR_SIZE);
+    else
+        memcpy(buf, p, (LONG)count * SECTOR_SIZE);
+    return E_OK;
+}
+
+LONG segacd_ramdisk_ioctl(WORD op, void *arg)
+{
+    ULONG *info = (ULONG *)arg;
+
+    if (!adisk_present)
+        return EUNDEV;
+
+    switch (op) {
+    case GET_DISKINFO:
+        info[0] = ADISK_SECTORS;
+        info[1] = SECTOR_SIZE;
+        return E_OK;
+    case GET_DISKNAME:
+        strcpy((char *)arg, "RamDisk");
+        return E_OK;
+    case GET_MEDIACHANGE:
+        /* It is in ROM. It was there at power-on and it will be there
+         * at power-off, and nothing in between can alter it. */
+        return MEDIANOCHANGE;
     }
+    return ERR;
+}
 
-    {                               /* internal BRAM, sub-side, direct */
-        ULONG off;
-        if (bram_state == BRAM_NONE) {
-            *(volatile UWORD *)0xFF802E = 0xEE01;
-            return EUNDEV;
-        }
-        if (lba + count > BRAM_SECTORS) {
-            *(volatile UWORD *)0xFF802E = 0xEE02;   /* out of range */
-            return ESECNF;
-        }
-        *(volatile UWORD *)0xFF802E = 0;
-        off = (ULONG)lba * SECTOR_SIZE;
-        while (count--) {
-            WORD i;
-            for (i = 0; i < SECTOR_SIZE; i++) {
-                if (rw & 1) bram_wr(off + i, buf[i]);
-                else        buf[i] = bram_rd(off + i);
-            }
-            buf += SECTOR_SIZE;
-            off += SECTOR_SIZE;
+LONG segacd_bram_rw(WORD rw, LONG sector, WORD count, UBYTE *buf)
+{
+    ULONG off;
+
+    if (bram_state == BRAM_NONE)
+        return EUNDEV;
+    if (sector < 0 || sector + count > BRAM_SECTORS)
+        return ESECNF;
+
+    off = (ULONG)sector * SECTOR_SIZE;
+    while (count--) {
+        WORD i;
+        for (i = 0; i < SECTOR_SIZE; i++) {
+            if (rw & RW_WRITE) bram_wr(off + i, buf[i]);
+            else               buf[i] = bram_rd(off + i);
         }
+        buf += SECTOR_SIZE;
+        off += SECTOR_SIZE;
+    }
+    return E_OK;
+}
+
+LONG segacd_bram_ioctl(WORD op, void *arg)
+{
+    ULONG *info = (ULONG *)arg;
+
+    if (bram_state == BRAM_NONE)
+        return EUNDEV;
+
+    switch (op) {
+    case GET_DISKINFO:
+        info[0] = BRAM_SECTORS;
+        info[1] = SECTOR_SIZE;
+        return E_OK;
+    case GET_DISKNAME:
+        strcpy((char *)arg, "Backup");
         return E_OK;
+    case GET_MEDIACHANGE:
+        /* Soldered to the board with a battery behind it. */
+        return MEDIANOCHANGE;
     }
+    return ERR;
 }
 
 /******************************************************************************/
