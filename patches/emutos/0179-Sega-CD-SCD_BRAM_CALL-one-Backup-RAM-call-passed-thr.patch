From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: emuTOS-MCD <darekadumon@gmail.com>
Date: Thu, 20 Aug 2026 09:01:37 +0000
Subject: [PATCH 179/184] Sega CD: SCD_BRAM_CALL, one Backup RAM call passed
 through

struct brmcall moves to scdapi.h so it is defined once: a .PRG has to
build the same block to use the new op, and two copies of a layout
shared by offset is how offsets drift. Field widths match either side --
EmuTOS's UWORD/ULONG are unsigned short/long.

SCD_BRAM_CALL (op 20) hands a block straight to the manager. The driver
fills in the work and string buffers for BRMINIT and BRMSTAT, because
those must be the same stable pair across every call and the manager
keeps a pointer to them; everything else -- filenames, info blocks, data
-- the caller supplies from its own memory, which for a .PRG is well
above the line. Any pointer below 0x6000 is refused rather than clamped:
it would be read out of whatever EmuTOS had parked there.

BRMWRITE, BRMDEL and BRMFORMAT invalidate the cached probe.

SCD_VERSION stays 35; the struct and ops are additions, and the size and
version check on scd_api is unchanged.
---
 bios/scdapi.h | 59 +++++++++++++++++++++++++++++++++++++++++++++++++++
 bios/segacd.c | 34 +++++++++++++++++++++++++++++
 bios/segacd.h | 38 ++++-----------------------------
 3 files changed, 97 insertions(+), 34 deletions(-)

diff --git a/bios/scdapi.h b/bios/scdapi.h
index ccf0191..0cbf7a7 100644
--- a/bios/scdapi.h
+++ b/bios/scdapi.h
@@ -143,6 +143,48 @@ struct scd_snap {
     unsigned short rep[32];
 };
 
+/* One call to Sega's Backup RAM manager. Shared by offset with
+ * segacd2.S's _segacd_buram_call, so the two change together.
+ *
+ * Everything reachable from here by pointer -- this block, the work
+ * area, any filename or data -- must sit at or above 0x6000. The visit
+ * exchanges 0..0x6000, so anything below is holding EmuTOS's own bytes
+ * by the time the manager reads it. A .PRG loads well above that; the
+ * driver refuses anything that is not. */
+struct brmcall {
+    unsigned short fn;                  /* BRM_* below */
+    unsigned short d0out;
+    unsigned short d1out;
+    unsigned short cs;                  /* nonzero: the manager said no */
+    unsigned long  d1in;
+    unsigned long  a0in;
+    unsigned long  a1in;
+    unsigned long  a0out;
+};
+
+/* Function codes for _BURAM (sub 0x5F16). megadev lib/sub/bram.def.h,
+ * MIT. Blocks are 0x40 bytes in normal mode, 0x20 in the protected one.
+ *
+ * BRMWRITE and BRMVERIFY take a 14-byte file info block:
+ *   filename[11], mode.b (0 normal, 0xFF protected), size.w in blocks
+ * Filenames are 11 characters, zero terminated. */
+#define BRM_INIT    0x0000
+#define BRM_STAT    0x0001
+#define BRM_SERCH   0x0002
+#define BRM_READ    0x0003
+#define BRM_WRITE   0x0004
+#define BRM_DEL     0x0005
+#define BRM_FORMAT  0x0006
+#define BRM_DIR     0x0007
+#define BRM_VERIFY  0x0008
+
+/* BRMINIT's d1 when it fails: 0 no RAM, 1 unformatted, 2 another
+ * format. Carry clear means Sega formatted, folded to 3 here. */
+#define BRM_ST_NONE     0
+#define BRM_ST_UNFORMAT 1
+#define BRM_ST_OTHER    2
+#define BRM_ST_SEGA     3
+
 /* Ops for scd_api.control(). Arguments that are not used are ignored;
  * the return value is meaningful only where noted. */
 #define SCD_TUNE      0                 /* a=lead b=hold c=late */
@@ -225,6 +267,23 @@ struct scd_snap {
  * Every field is a byte because every one of them fits: 0x100 blocks is
  * the largest memory, and free space clamps. */
 #define SCD_BRAM_INFO     19
+/* One Backup RAM call, straight through to Sega's manager. a points at
+ * a struct brmcall (bios/segacd.h); the driver fills in the work and
+ * string buffers for BRMINIT and BRMSTAT, because those must be the
+ * same stable pair across every call and the manager keeps a pointer to
+ * them. Everything else -- filenames, file-info structs, data -- the
+ * caller supplies.
+ *
+ * Every pointer must be at or above 0x6000. The visit exchanges
+ * 0..0x6000, so anything below that is holding EmuTOS's own bytes by
+ * the time the manager reads it. A .PRG is loaded well above the line
+ * and its statics are fine; the driver refuses rather than trusting it.
+ *
+ * Returns E_OK when the call was made -- the manager's own answer is in
+ * the block's cs/d0out/d1out/a0out, not here. EBADRQ means it was not
+ * made at all: no firmware parked, or a pointer that would have been
+ * parked underneath it. */
+#define SCD_BRAM_CALL     20
 #define SCD_CARTSWAP      11            /* Mode 1: expect the cartridge to
                                          * be pulled and another put in */
 
diff --git a/bios/segacd.c b/bios/segacd.c
index d4531a7..f8f7452 100644
--- a/bios/segacd.c
+++ b/bios/segacd.c
@@ -3810,6 +3810,7 @@ static ULONG bulk_base, bulk_len, disk_base, disk_len;
  */
 static WORD cart_xfer(UWORD op, UWORD lba);     /* below, with the cart */
 static ULONG segacd_buram_info(BOOL again);      /* below, with the BRAM */
+static ULONG segacd_buram_pass(struct brmcall *c);
 
 #define PRN_PAGE    4096
 #define PRN_IDLE_TICKS  100     /* hz_200: half a second of silence ends it */
@@ -3948,6 +3949,7 @@ static ULONG scd_control(LONG op, LONG a, LONG b, LONG c)
     case SCD_BIOS_READTEST: return segacd_bios_readtest();
     case SCD_BIOS_NEARREAD: return segacd_bios_nearread();
     case SCD_BRAM_INFO:     return segacd_buram_info(a != 0);
+    case SCD_BRAM_CALL:     return segacd_buram_pass((struct brmcall *)a);
     case SCD_BIOS_SWAPS:    return segacd_bios_swaps();
     }
     return 0;
@@ -4664,6 +4666,38 @@ static void segacd_buram_probe(void)
 /* Packed for SCD_BRAM_INFO. Probed on demand rather than at boot: two
  * visits to the parked firmware cost about six milliseconds, and until
  * something asks there is nothing to spend them on. */
+/* One call, passed through. See SCD_BRAM_CALL in scdapi.h. */
+static ULONG segacd_buram_pass(struct brmcall *c)
+{
+    if (!c || (ULONG)c < 0x6000UL)
+        return (ULONG)EBADRQ;
+    if (!segacd_buram_ready())
+        return (ULONG)EBADRQ;
+
+    switch (c->fn) {
+    case BRM_INIT:
+        c->a0in = (ULONG)brm_work;
+        c->a1in = (ULONG)brm_names;
+        break;
+    case BRM_STAT:
+        c->a1in = (ULONG)brm_names;
+        break;
+    default:
+        /* A pointer under the line would be read out of whatever
+         * EmuTOS had there, which is the failure this whole file spent
+         * a day on once already. Refused, not clamped. */
+        if (c->a0in && c->a0in < 0x6000UL) return (ULONG)EBADRQ;
+        if (c->a1in && c->a1in < 0x6000UL) return (ULONG)EBADRQ;
+        break;
+    }
+    segacd_buram_call(c);
+    /* Any call that could have changed the volume invalidates what the
+     * cached probe last said about it. */
+    if (c->fn == BRM_WRITE || c->fn == BRM_DEL || c->fn == BRM_FORMAT)
+        brm_checked = 0;
+    return (ULONG)E_OK;
+}
+
 static ULONG segacd_buram_info(BOOL again)
 {
     ULONG st, sz, fr, nf;
diff --git a/bios/segacd.h b/bios/segacd.h
index 3328e54..a76e508 100644
--- a/bios/segacd.h
+++ b/bios/segacd.h
@@ -116,42 +116,12 @@ void segacd_call_5ms(void);
 
 /* Sega's own Backup RAM manager, through the parked firmware.
  *
- * Layout is shared with segacd2.S by offset, so the two must be changed
- * together. Everything reachable from here by pointer -- this block, the
- * work area, the string buffer, any data -- has to sit outside the 24 KB
- * the visit exchanges, which rules out both the stack (0x800) and the
- * start of .bss (0x2140). segacd_buram_ready() is where that is checked
- * rather than assumed. */
-struct brmcall {
-    UWORD fn;                   /* BRM_* below */
-    UWORD d0out;
-    UWORD d1out;
-    UWORD cs;                   /* nonzero: the BIOS reported failure */
-    ULONG d1in;
-    ULONG a0in;
-    ULONG a1in;
-    ULONG a0out;
-};
+ * struct brmcall is in scdapi.h, defined once, because a .PRG has to
+ * build the same block to use SCD_BRAM_CALL and two copies of a layout
+ * shared by offset is how offsets drift. Its field widths are the same
+ * either side: EmuTOS's UWORD/ULONG are unsigned short/long. */
 void segacd_buram_call(struct brmcall *c);      /* segacd2.S */
 
-/* Function codes for _BURAM (0x5F16). megadev lib/sub/bram.def.h, MIT. */
-#define BRM_INIT    0x0000
-#define BRM_STAT    0x0001
-#define BRM_SERCH   0x0002
-#define BRM_READ    0x0003
-#define BRM_WRITE   0x0004
-#define BRM_DEL     0x0005
-#define BRM_FORMAT  0x0006
-#define BRM_DIR     0x0007
-#define BRM_VERIFY  0x0008
-
-/* BRMINIT's status in d1 when it fails: 0 no RAM, 1 unformatted, 2 some
- * other format. Success is carry clear, and then d0 is the size in
- * blocks of 0x1000 bytes -- 2 for the internal 8 KB, up to 0x100. */
-#define BRM_ST_NONE     0
-#define BRM_ST_UNFORMAT 1
-#define BRM_ST_OTHER    2
-#define BRM_ST_SEGA     3       /* ours, for the carry-clear case */
 
 #endif /* MACHINE_SEGACD */
 
