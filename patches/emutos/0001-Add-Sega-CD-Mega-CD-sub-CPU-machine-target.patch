diff --git a/bios/segacd.c b/bios/segacd.c
new file mode 100644
index 0000000..50b8285
--- /dev/null
+++ b/bios/segacd.c
@@ -0,0 +1,114 @@
+/*
+ * segacd.c - Sega CD (Mega CD) sub-CPU specific functions
+ *
+ * Copyright (C) 2026 The EmuTOS development team
+ *
+ * This file is distributed under the GPL, version 2 or at your
+ * option any later version.  See doc/license.txt for details.
+ *
+ * EmuTOS runs on the Sega CD's sub 68000 (12.5 MHz), whose address 0 is
+ * PRG-RAM — the ST low-memory ABI holds byte-authentic. The Genesis-side
+ * main 68000 runs a servant firmware that converts the ST-low planar
+ * screen to VDP tiles, samples controllers, and proxies the backup-RAM
+ * cartridge. The Sega CDBIOS is used only by the boot loader and is gone
+ * before EmuTOS starts (it owned the same low RAM the ST ABI needs).
+ *
+ * Sub-CPU hardware used here (gate array at 0xFF8000):
+ *   0xFF8031  timer: counts down every 30.72 us, 0 disables, IRQ3 on zero
+ *   0xFF8033  interrupt mask: bit n enables level-n interrupt
+ * Level 2 is raised by the main CPU once per vblank (our VBL).
+ */
+
+#include "emutos.h"
+
+#ifdef MACHINE_SEGACD
+
+#include "segacd.h"
+#include "screen.h"
+#include "vectors.h"
+#include "tosvars.h"
+#include "biosext.h"
+
+#define GA_TIMER    (*(volatile UBYTE *)0xFF8031)
+#define GA_INTMASK  (*(volatile UBYTE *)0xFF8033)
+
+/* 200 Hz: 5000 us / 30.72 us = 162.76; 163 gives 199.7 Hz */
+#define TIMER_200HZ 163
+
+/******************************************************************************/
+/* Screen                                                                     */
+/******************************************************************************/
+
+/* The screen is an authentic ST-low buffer (320x200, 4 interleaved
+ * bitplanes). EmuTOS's standard top-of-RAM allocation puts it at
+ * phystop - 32K = 0x58000, inside main-window PRG bank 2, where the
+ * servant reads it. No video hardware exists on this side; the address
+ * is only bookkeeping. */
+
+static const UBYTE *segacd_screenbase;
+
+void segacd_screen_init(void)
+{
+    sshiftmod = ST_LOW;
+
+    /* VBL arrives from the main CPU as level 2 */
+    VEC_LEVEL2 = segacd_int_2;
+
+    /* enable level 2 (VBL) + level 3 (timer) in the gate array */
+    GA_INTMASK |= 0x0C;
+}
+
+void segacd_setphys(const UBYTE *addr)
+{
+    segacd_screenbase = addr;
+}
+
+const UBYTE *segacd_physbase(void)
+{
+    if (segacd_screenbase)
+        return segacd_screenbase;
+    return logbase();
+}
+
+/******************************************************************************/
+/* System timer                                                               */
+/******************************************************************************/
+
+void segacd_init_system_timer(void)
+{
+    VEC_LEVEL3 = segacd_int_3;
+    GA_TIMER = TIMER_200HZ;     /* starts the countdown */
+}
+
+/******************************************************************************/
+/* Interrupts                                                                 */
+/******************************************************************************/
+
+/* INT2 C handler: VBL from the main CPU. */
+void segacd_int_2_c(void)
+{
+    int_vbl();
+}
+
+/******************************************************************************/
+/* Keyboard                                                                   */
+/******************************************************************************/
+
+void segacd_kbd_init(void)
+{
+    /* Input events will be injected from the main-CPU servant's comm
+     * registers (pad + Sega Mouse); nothing to initialize yet. */
+}
+
+/******************************************************************************/
+/* Clock                                                                      */
+/******************************************************************************/
+
+ULONG segacd_getdt(void)
+{
+    /* No RTC: fixed date until BRAM-backed clock storage arrives.
+     * Format: date word (DOS format) in the high word, time in the low. */
+    return MAKE_ULONG(((2026 - 1980) << 9) | (8 << 5) | 9, 0);
+}
+
+#endif /* MACHINE_SEGACD */
