+ * option any later version.  See doc/license.txt for details.
+ */
+
+#ifndef SEGACD_H
+#define SEGACD_H
+
+#ifdef MACHINE_SEGACD
+
+/* Screen */
+void segacd_screen_init(void);
+void segacd_setphys(const UBYTE *addr);
+const UBYTE *segacd_physbase(void);
+
+/* System timer (gate array INT3) */
+void segacd_init_system_timer(void);
+
+/* Keyboard/mouse (events arrive from the main-CPU servant; stub for now) */
+void segacd_kbd_init(void);
+
+/* Clock */
+ULONG segacd_getdt(void);
+
+/* Interrupt handlers (assembler entry points in segacd2.S) */
+void segacd_int_2(void);        /* INT2: VBL, raised by the main CPU */
+void segacd_int_3(void);        /* INT3: gate array timer, 200 Hz */
+void segacd_int_2_c(void);
+void segacd_call_5ms(void);
+
+#endif /* MACHINE_SEGACD */
+
+#endif /* SEGACD_H */
diff --git a/bios/segacd2.S b/bios/segacd2.S
new file mode 100644
index 0000000..1406fce
--- /dev/null
+++ b/bios/segacd2.S
@@ -0,0 +1,49 @@
+/*
+ * segacd2.S - Sega CD (Mega CD) specific assembler functions
+ *
+ * Copyright (C) 2026 The EmuTOS development team
+ *
+ * This file is distributed under the GPL, version 2 or at your
+ * option any later version.  See doc/license.txt for details.
+ */
+
+#include "asmdefs.h"
+
+#ifdef MACHINE_SEGACD
+
+        .extern _segacd_int_2_c
+        .extern _vector_5ms
+
+/******************************************************************************/
+/* Interrupts                                                                 */
+/******************************************************************************/
+
+// Level 2: VBL, raised by the main CPU each vblank
+        .globl  _segacd_int_2
+_segacd_int_2:
+        move.w  #0x2700,sr              // Forbid higher level interrupts
+        movem.l d0-d1/a0-a1,-(sp)
+        jbsr    _segacd_int_2_c         // Delegate to C implementation
+        movem.l (sp)+,d0-d1/a0-a1
+        rte
+
+// Level 3: gate array timer, 200 Hz system tick
+        .globl  _segacd_int_3
+_segacd_int_3:
+        move.w  #0x2700,sr              // Forbid higher level interrupts
+        movem.l d0-d1/a0-a1,-(sp)
+        jbsr    _segacd_call_5ms
+        movem.l (sp)+,d0-d1/a0-a1
+        rte
+
+// Call vector_5ms (200 Hz system timer callback) from the handler above.
+// As it will return with RTE, we must set up a proper stack frame.
+        .globl  _segacd_call_5ms
+_segacd_call_5ms:
+        // The return address is already on the stack.
+        // The sub CPU is always a 68000, so _longframe is false.
+        move.w  sr,-(sp)                // Push SR
+        move.l  _vector_5ms,a0
+        jmp     (a0)                    // Call the 200 Hz system callback
+
+#endif /* MACHINE_SEGACD */
