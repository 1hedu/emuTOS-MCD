      */
     KDEBUG(("screen_init_mode()\n"));
-    screen_init_mode(); /* detect monitor type, ... */
+    SCTRACE(15); screen_init_mode(); /* detect monitor type, ... */
 
     /* Set up the BIOS console output */
     KDEBUG(("linea_init()\n"));
-    linea_init();       /* initialize screen related line-a variables */
