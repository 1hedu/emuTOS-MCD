+/* One number per step of bios_init, so a boot that stops has to say
+ * where. The high-water mark of these is what the Mode 1 loader reads
+ * out of the comm register, and it costs a word store per init call on
+ * a path that runs once. */
+#ifdef MACHINE_SEGACD
+#define SCTRACE(n) (*(volatile UWORD *)0xFF8020 = (UWORD)(0xE100u + (n)))
+#else
+#define SCTRACE(n)
+#endif
