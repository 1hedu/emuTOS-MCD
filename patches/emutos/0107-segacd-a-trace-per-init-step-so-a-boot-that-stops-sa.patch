diff --git a/bios/blkdev.c b/bios/blkdev.c
index d180a42..3894d42 100644
--- a/bios/blkdev.c
+++ b/bios/blkdev.c
@@ -168,6 +168,12 @@ static void pun_info_setup(void)
  *
  */
 
+#ifdef MACHINE_SEGACD
+#define SCTRACE2(n) (*(volatile UWORD *)0xFF8020 = (UWORD)(0xE200u + (n)))
+#else
+#define SCTRACE2(n)
+#endif
+
 static void blkdev_hdv_init(void)
 {
     /* Start with no drives. This matters for EmuTOS-RAM, because the system
@@ -175,24 +181,29 @@ static void blkdev_hdv_init(void)
     drvbits = 0;
 
     /* Detect and initialize floppy drives */
+    SCTRACE2(1);
     flop_hdv_init();
 
     /*
      * do bus initialisation, such as setting delay values
      */
+    SCTRACE2(2);
     bus_init();
 
 #if CONF_WITH_SCSI_DRIVER
     scsidriv_init();    /* detect all devices */
 #endif
 
+    SCTRACE2(3);
     disk_init_all();    /* Detect hard disk partitions */
 
 #if CONF_WITH_XHDI
     init_XHDI_drvmap(); /* remember drives that we control */
 #endif
 
+    SCTRACE2(4);
     pun_info_setup();
+    SCTRACE2(5);
 }
 
