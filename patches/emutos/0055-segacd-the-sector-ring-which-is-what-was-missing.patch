@@ -1064,7 +1130,7 @@ static void cdr_step(void)
     case CDR_STREAM:
         cdr_wait++;
         if (cdc_hit) {
-            BOOL ok = cdc_grab();
+            BOOL ok = cdc_grab(cdc_pt);
 
