From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: emuTOS-MCD <darekadumon@gmail.com>
Date: Tue, 11 Aug 2026 19:26:02 +0000
Subject: [PATCH 055/184] segacd: the sector ring, which is what was missing

The old reader asked the drive for sector N and then tried to be
listening at the microsecond it went past. Between one GEMDOS call and
the next the head moves on, so it missed, seeked, and missed again --
which is why D: worked in an emulator and raced on a console.

The decoder interrupt now writes down every sector it reports: which
one it was, and where in the decoder's own 16K buffer it landed. The
foreground looks in the ring instead of chasing. That buffer holds
about eight sectors, so a reader has most of a tenth of a second to
come and collect, which against GEMDOS is forever.

This is $1F0A, and CDCREAD taking its buffer address from the entry
the handler left. docs/cdd-bios-notes.md named the omission at the
moment it was made -- 'the one place our driver will deliberately
differ from Sega's, and the place to look first if it misbehaves' --
and then four rounds were spent tuning timeouts around it instead of
reading that back.

Read errors during a full Dfree, Fsfirst, Fopen and Fread of the disc:
five before, none after.
---
 bios/segacd.c | 256 ++++++++++++++++++++++----------------------------
 1 file changed, 113 insertions(+), 143 deletions(-)

diff --git a/bios/segacd.c b/bios/segacd.c
index 646ec75..a83b779 100644
--- a/bios/segacd.c
+++ b/bios/segacd.c
@@ -146,7 +146,6 @@ static UBYTE cdd_cmd_on;        /* holding A at power-on turns these off */
 static ULONG cd_cached = 0xFFFFFFFFUL;  /* which CD sector is in CDSECT */
 static ULONG cd_cache_base;
 static UBYTE cd_cache_have;
-static ULONG cd_next;           /* the one the drive will deliver next */
 static UBYTE cd_streaming;
 static UWORD cd_errors;         /* reads that gave up */
 static UBYTE cd_quiet;          /* the read command has been withdrawn */
@@ -157,6 +156,54 @@ static UWORD cd_why;            /* nibble per attempt of the last
                                  * head was already past, 3 the
                                  * transfer itself failed */
 static UWORD cd_seeks, cd_hits; /* seeks against sectors simply waited for */
+/* The sector ring.
+ *
+ * This is the piece Sega has and this driver did not, and going without
+ * it is why D: works in an emulator and races on a console. The old
+ * shape asked the drive for sector N and then tried to be listening at
+ * the microsecond it went past; between one GEMDOS call and the next
+ * the head moves on, so it missed, seeked, and missed again.
+ *
+ * The decoder interrupt now writes down every sector it reports --
+ * which one it was, and where in the decoder's own 16K buffer it
+ * landed. The foreground never has to catch anything: it looks in the
+ * ring. That buffer holds about eight sectors, so a reader has most of
+ * a tenth of a second to come and collect, which is forever.
+ *
+ * $1F0A does exactly this and CDCREAD takes its buffer address from the
+ * entry the handler left. docs/cdd-bios-notes.md named the omission
+ * when it was made: "the one place our driver will deliberately differ
+ * from Sega's, and the place to look first if it misbehaves". */
+#define CD_RING 6               /* under the decoder's own capacity */
+
+static volatile ULONG cd_ring_lba[CD_RING];
+static volatile UWORD cd_ring_pt[CD_RING];
+static volatile UBYTE cd_ring_head;
+static volatile ULONG cd_ring_newest = 0xFFFFFFFFUL;
+
+static void cd_ring_reset(void)
+{
+    UBYTE i;
+
+    for (i = 0; i < CD_RING; i++)
+        cd_ring_lba[i] = 0xFFFFFFFFUL;
+    cd_ring_head = 0;
+    cd_ring_newest = 0xFFFFFFFFUL;
+}
+
+static BOOL cd_ring_find(ULONG lba, UWORD *pt)
+{
+    UBYTE i;
+
+    for (i = 0; i < CD_RING; i++) {
+        if (cd_ring_lba[i] == lba) {
+            *pt = cd_ring_pt[i];
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
 /* Whether D: has ever been read: bit 0 tried, bit 1 succeeded.
  *
  * This used to be a set of deliberate probes at boot, and it was a bad
@@ -611,6 +658,7 @@ static void cdc_setup(void)
     cd_cache_base = 0xFFFFFFFFUL;
     cd_cache_have = 0;
     cd_streaming = 0;
+    cd_ring_reset();
 
     *CDC_AR = 0x0F; *CDC_DATA = 0x00;                   /* RESET */
     *CDC_AR = 0x01; *CDC_DATA = 0x3A;                   /* IFCTRL */
@@ -683,6 +731,24 @@ void segacd_int_5_c(void)
         cdc_pt = cdc_pt_last;
         cdc_hit = 1;
     }
+
+    /* Note it in the ring, whether or not anybody asked for it. Cheap:
+     * a couple of multiplies and three stores, against the alternative
+     * of a reader trying to be awake at the right moment. */
+    if (h3 == 0x01 || h3 == 0x02) {     /* a data sector, mode 1 or 2 */
+        UBYTE k = cd_ring_head;
+        ULONG lba = (ULONG)(((h0 >> 4) * 10 + (h0 & 0x0F))) * 4500UL
+                  + (ULONG)(((h1 >> 4) * 10 + (h1 & 0x0F))) * 75UL
+                  + (ULONG)(((h2 >> 4) * 10 + (h2 & 0x0F)));
+
+        if (lba >= 150UL) {
+            lba -= 150UL;
+            cd_ring_lba[k] = lba;
+            cd_ring_pt[k] = cdc_pt_last;
+            cd_ring_head = (UBYTE)((k + 1) % CD_RING);
+            cd_ring_newest = lba;
+        }
+    }
 }
 
