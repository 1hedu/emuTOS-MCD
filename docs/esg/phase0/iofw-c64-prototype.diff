 }
+/* plane B under C64 cells: opaque black so C64 colour 0 (pixel 0) is black */
+static void c64_planeb(void)
+{
+    uint16_t row, col;
+    for (row = 0; row < 25u; row++) {
+        const uint8_t *m = &c64m[row * 5u];
+        uint16_t sr = irq_off();
+        VU32(VDP_CTRL) = vdp_vram_w((uint16_t)(PLANEB + row * 128u));
+        for (col = 0; col < 40u; col++)
+            VU16(VDP_DATA) = (m[col >> 3] & (0x80u >> (col & 7)))
+                ? (uint16_t)(PAL_OURS | TILE_INK) : (uint16_t)(PAL_OURS | TILE_PAPER);
+        irq_restore(sr);
+    }
+}
+static uint16_t c64_gen = 0xFFFFu;
+#define C64BLK_OFF 32256u       /* past the raster block (RASBLK_OFF 32240, 10 B) */
+static void c64_block(uint32_t woff)
+{
+    const volatile uint16_t *cb = (const volatile uint16_t *)
+        (PRG_WINDOW + woff + C64BLK_OFF);
+    uint16_t i, n;
+    if (cb[0] != 0x4336u || cb[1] != 0x3421u) {
+        if (c64_gen == 0xFFFFu) return;
+        n = 0;                                 /* block gone: clear */
+    } else {
+        if (cb[2] == c64_gen) return;
+        n = cb[3]; if (n > 16u) n = 16u;
+    }
+    c64_gen = (cb[0] == 0x4336u) ? cb[2] : 0xFFFFu;
+    if (n) {
+        uint16_t sr = irq_off();
+        VU32(VDP_CTRL) = vdp_cram_w(2 * 32);
+        for (i = 0; i < 16; i++) VU16(VDP_DATA) = cb[4 + i];
+        irq_restore(sr);
+    }
+    for (i = 0; i < 125u; i++) c64m[i] = 0;
+    for (i = 0; i < n; i++) {
+        uint16_t xy = cb[20 + 2*i], wh = cb[21 + 2*i];
+        uint16_t c0 = xy >> 8, r0 = xy & 0xFF, c1 = c0 + (wh >> 8), r1 = r0 + (wh & 0xFF), r, c;
+        if (c1 > 40u) c1 = 40u; if (r1 > 25u) r1 = 25u;
+        for (r = r0; r < r1; r++)
+            for (c = c0; c < c1; c++)
+                c64m[r * 5u + (c >> 3)] |= (uint8_t)(0x80u >> (c & 7));
+    }
+    screen_scroll_apply();
+    c64_planeb();
+}
 
